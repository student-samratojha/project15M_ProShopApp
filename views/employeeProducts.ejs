<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Products - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
        .fade-in { animation: fadeIn 0.3s ease-in; }
        @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-slate-50 to-green-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-green-600">ProShop Employee</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Welcome, <%= employee.name %></span>
                    <a href="/secure/employee" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Back to Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <!-- Header -->
        <div class="mb-12">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Manage Your Products</h1>
            <p class="text-gray-600 text-lg">View, edit, and manage all your products in one place</p>
        </div>

        <!-- Create Product Button -->
        <div class="mb-8">
            <a href="/products/create" class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl shadow-lg hover:shadow-xl transition transform hover:scale-105 text-center">
                <svg class="w-6 h-6 text-yellow-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                <span class="text-yellow-900 font-bold text-lg">Add New Product</span>
            </a>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
            <!-- Total Products -->
            <div class="bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-800 font-semibold text-sm mb-1">Total Products</p>
                        <p class="text-3xl font-bold text-yellow-900"><%= products.length %></p>
                    </div>
                    <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V11a2 2 0 012-2z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Active Products -->
            <div class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-800 font-semibold text-sm mb-1">Active Products</p>
                        <p class="text-3xl font-bold text-green-900"><%= products.filter(p => p.status === 'active').length %></p>
                    </div>
                    <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Featured Products -->
            <div class="bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-purple-800 font-semibold text-sm mb-1">Featured Products</p>
                        <p class="text-3xl font-bold text-purple-900"><%= products.filter(p => p.isFeatured).length %></p>
                    </div>
                    <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Products Grid -->
        <% if (products.length > 0) { %>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                <% products.forEach((product) => { %>
                    <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition transform hover:scale-105 overflow-hidden fade-in">
                        <!-- Image Section -->
                        <div class="relative h-48 bg-gradient-to-br from-yellow-50 to-orange-50 overflow-hidden group">
                            <% if (product.thumbnail) { %>
                                <img src="<%= product.thumbnail %>" alt="<%= product.name %>" class="w-full h-full object-cover group-hover:scale-110 transition duration-300">
                            <% } else { %>
                                <div class="w-full h-full flex items-center justify-center">
                                    <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                </div>
                            <% } %>
                            <!-- Status Badge -->
                            <div class="absolute top-3 right-3">
                                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold <%= product.status === 'active' ? 'bg-green-100 text-green-800' : product.status === 'inactive' ? 'bg-gray-100 text-gray-800' : 'bg-red-100 text-red-800' %>">
                                    <%= product.status %>
                                </span>
                            </div>
                            <!-- Featured Badge -->
                            <% if (product.isFeatured) { %>
                                <div class="absolute top-3 left-3">
                                    <span class="inline-flex items-center space-x-1 bg-yellow-100 text-yellow-800 px-3 py-1 rounded-full text-xs font-bold">
                                        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                                            <path d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                        </svg>
                                        <span>Featured</span>
                                    </span>
                                </div>
                            <% } %>
                        </div>

                        <!-- Content Section -->
                        <div class="p-6">
                            <!-- Title -->
                            <h3 class="text-lg font-bold text-gray-900 mb-2 truncate"><%= product.name %></h3>
                            
                            <!-- Category & SKU -->
                            <div class="text-sm text-gray-600 mb-3">
                                <p><span class="font-semibold">Category:</span> <%= product.category ? product.category.title : 'N/A' %></p>
                                <p><span class="font-semibold">SKU:</span> <%= product.sku || 'N/A' %></p>
                            </div>

                            <!-- Price Section -->
                            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-xl p-3 mb-3">
                                <div class="flex items-center justify-between">
                                    <div>
                                        <p class="text-xs text-gray-600 mb-1">Price</p>
                                        <p class="text-2xl font-bold text-blue-900">$<%= product.price.toFixed(2) %></p>
                                    </div>
                                    <% if (product.discountPrice > 0) { %>
                                        <div class="text-right">
                                            <p class="text-xs text-gray-600 mb-1">Discount</p>
                                            <p class="text-lg font-bold text-green-600">-$<%= (product.price - product.discountPrice).toFixed(2) %></p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Stock Section -->
                            <div class="mb-4">
                                <p class="text-xs text-gray-600 font-semibold mb-2">Stock Level</p>
                                <div class="inline-block px-3 py-1 rounded-full text-xs font-semibold <%= product.stock > 10 ? 'bg-green-100 text-green-800' : product.stock > 0 ? 'bg-yellow-100 text-yellow-800' : 'bg-red-100 text-red-800' %>">
                                    <%= product.stock %> units <%= product.stock > 10 ? '(High)' : product.stock > 0 ? '(Low)' : '(Out of Stock)' %>
                                </div>
                            </div>

                            <!-- Description Preview -->
                            <% if (product.shortDescription) { %>
                                <p class="text-sm text-gray-600 mb-4 line-clamp-2"><%= product.shortDescription %></p>
                            <% } %>

                            <!-- Action Buttons -->
                            <div class="flex gap-3">
                                <a href="/products/edit/<%= product._id %>" class="flex-1 inline-flex items-center justify-center px-4 py-2 bg-gradient-to-r from-blue-100 to-blue-200 text-blue-900 rounded-lg hover:shadow-lg transition font-semibold text-sm">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                    </svg>
                                    Edit
                                </a>
                                <form method="POST" action="/products/delete" class="flex-1" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                    <input type="hidden" name="id" value="<%= product._id %>">
                                    <button type="submit" class="w-full inline-flex items-center justify-center px-4 py-2 bg-gradient-to-r from-red-100 to-red-200 text-red-900 rounded-lg hover:shadow-lg transition font-semibold text-sm">
                                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <!-- Empty State -->
            <div class="bg-white rounded-2xl shadow-lg p-12 text-center">
                <div class="bg-yellow-100 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m0 0l8-4m0 0l8 4m0 0v10l-8 4m0 0l-8-4m0 0v-10"></path>
                    </svg>
                </div>
                <h3 class="text-3xl font-bold text-gray-900 mb-3">No Products Yet</h3>
                <p class="text-gray-600 mb-8 text-lg">You haven't created any products yet. Start by adding your first product to your inventory!</p>
                <a href="/products/create" class="inline-flex items-center px-8 py-4 bg-gradient-to-br from-yellow-100 to-yellow-200 text-yellow-900 font-bold rounded-lg hover:shadow-lg transition transform hover:scale-105">
                    <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Create Your First Product
                </a>
            </div>
        <% } %>
    </div>

    <!-- Footer -->
    <div class="bg-white border-t border-gray-200 mt-12">
        <div class="max-w-7xl mx-auto px-4 py-8 text-center text-gray-600">
            <p>&copy; 2024 ProShop. All rights reserved.</p>
        </div>
    </div>
</body>
</html>
