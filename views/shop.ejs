<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-yellow-600">ProShop</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <% if (user) { %>
                        <span class="text-gray-700 font-medium">Welcome, <%= user.name %></span>
                        <a href="/" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Home</a>
                        <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                    <% } else { %>
                        <a href="/" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Home</a>
                        <a href="/auth/login" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Login</a>
                        <a href="/auth/register" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Register</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 py-12">
        <!-- Header -->
        <div class="mb-12">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Shop</h1>
            <p class="text-gray-600 text-lg">Browse our extensive collection of quality products</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
            <!-- Sidebar Filters -->
            <div class="lg:col-span-1">
                <div class="bg-white rounded-2xl p-6 shadow-lg sticky top-20">
                    <h2 class="text-xl font-bold text-yellow-900 mb-6">Filters</h2>

                    <!-- Price Filter -->
                    <div class="mb-8 pb-6 border-b border-gray-200">
                        <h3 class="font-bold text-gray-900 mb-4">Price Range</h3>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input type="radio" name="price" value="all" checked class="mr-2">
                                <span class="text-gray-700">All Prices</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="price" value="0-500" class="mr-2">
                                <span class="text-gray-700">₹0 - ₹500</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="price" value="500-1000" class="mr-2">
                                <span class="text-gray-700">₹500 - ₹1000</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="price" value="1000-5000" class="mr-2">
                                <span class="text-gray-700">₹1000 - ₹5000</span>
                            </label>
                            <label class="flex items-center">
                                <input type="radio" name="price" value="5000+" class="mr-2">
                                <span class="text-gray-700">₹5000+</span>
                            </label>
                        </div>
                    </div>

                    <!-- Stock Filter -->
                    <div class="mb-8 pb-6 border-b border-gray-200">
                        <h3 class="font-bold text-gray-900 mb-4">Availability</h3>
                        <div class="space-y-2">
                            <label class="flex items-center">
                                <input type="checkbox" class="mr-2 stock-filter" value="instock">
                                <span class="text-gray-700">In Stock</span>
                            </label>
                            <label class="flex items-center">
                                <input type="checkbox" class="mr-2 stock-filter" value="outofstock">
                                <span class="text-gray-700">Out of Stock</span>
                            </label>
                        </div>
                    </div>

                    <!-- Sort -->
                    <div>
                        <h3 class="font-bold text-gray-900 mb-4">Sort By</h3>
                        <select id="sortBy" class="w-full px-4 py-2 border-2 border-yellow-100 rounded-lg focus:border-yellow-400 bg-yellow-50">
                            <option value="newest">Newest</option>
                            <option value="price-low">Price: Low to High</option>
                            <option value="price-high">Price: High to Low</option>
                        </select>
                    </div>

                    <!-- Reset Button -->
                    <button class="w-full mt-6 py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-lg hover:shadow-lg transition">
                        Reset Filters
                    </button>
                </div>
            </div>

            <!-- Products Grid -->
            <div class="lg:col-span-3">
                <% if (products && products.length > 0) { %>
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                        <% products.forEach(function(product) { %>
                            <div class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-xl transition transform hover:scale-105">
                                <!-- Product Image -->
                                <div class="relative bg-gradient-to-br from-yellow-100 to-yellow-200 h-48 flex items-center justify-center overflow-hidden group">
                                    <svg class="w-24 h-24 text-yellow-600 group-hover:scale-110 transition" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 015.646 5.646 9 9 0 0120.354 15.354z"></path>
                                    </svg>
                                    
                                    <!-- Discount Badge -->
                                    <% if (product.discountPrice && product.discountPrice > 0) { %>
                                        <div class="absolute top-3 right-3 bg-red-500 text-white px-3 py-1 rounded-full text-sm font-bold">
                                            <% let discount = Math.round(((product.price - product.discountPrice) / product.price) * 100); %>
                                            <%= discount %>% OFF
                                        </div>
                                    <% } %>

                                    <!-- Stock Badge -->
                                    <div class="absolute top-3 left-3">
                                        <% if (product.stock > 0) { %>
                                            <span class="inline-block px-3 py-1 bg-green-500 text-white rounded-full text-xs font-bold">In Stock</span>
                                        <% } else { %>
                                            <span class="inline-block px-3 py-1 bg-red-500 text-white rounded-full text-xs font-bold">Out of Stock</span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Product Details -->
                                <div class="p-6">
                                    <!-- Product Name -->
                                    <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2">
                                        <%= product.title || product.name %>
                                    </h3>

                                    <!-- Description -->
                                    <p class="text-sm text-gray-600 mb-3 line-clamp-2">
                                        <%= product.description || product.shortDescription || 'Premium quality product' %>
                                    </p>

                                    <!-- Price Section -->
                                    <div class="mb-4">
                                        <% if (product.discountPrice && product.discountPrice > 0) { %>
                                            <div class="flex items-center space-x-2 mb-2">
                                                <span class="text-2xl font-bold text-yellow-600">₹<%= product.discountPrice %></span>
                                                <span class="text-lg text-gray-400 line-through">₹<%= product.price %></span>
                                            </div>
                                        <% } else { %>
                                            <span class="text-2xl font-bold text-yellow-600">₹<%= product.price %></span>
                                        <% } %>
                                    </div>

                                    <!-- Product Stats -->
                                    <div class="grid grid-cols-2 gap-2 mb-4 text-sm">
                                        <div class="bg-blue-50 rounded-lg p-2 text-center">
                                            <p class="text-gray-600 text-xs">Stock</p>
                                            <p class="font-bold text-gray-900"><%= product.stock %></p>
                                        </div>
                                        <div class="bg-green-50 rounded-lg p-2 text-center">
                                            <p class="text-gray-600 text-xs">Sold</p>
                                            <p class="font-bold text-gray-900"><%= product.sold || 0 %></p>
                                        </div>
                                    </div>

                                    <!-- Action Buttons -->
                                    <div class="flex flex-col gap-2">
                                        <% if (product.stock > 0) { %>
                                            <a href="/booking/make?id=<%= product._id %>" class="w-full py-2 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-lg hover:shadow-lg transition text-center">
                                                Book Now
                                            </a>
                                        <% } else { %>
                                            <button disabled class="w-full py-2 bg-gray-300 text-gray-600 font-bold rounded-lg cursor-not-allowed text-center">
                                                Out of Stock
                                            </button>
                                        <% } %>
                                        <button class="w-full py-2 border-2 border-yellow-300 text-yellow-700 font-bold rounded-lg hover:bg-yellow-50 transition">
                                            <span class="inline-flex items-center justify-center">
                                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                                                </svg>
                                                Wishlist
                                            </span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } else { %>
                    <!-- Empty State -->
                    <div class="bg-white rounded-2xl p-12 shadow-lg text-center">
                        <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 015.646 5.646 9 9 0 0120.354 15.354z"></path>
                        </svg>
                        <h3 class="text-2xl font-bold text-gray-900 mb-2">No products found</h3>
                        <p class="text-gray-600 mb-6">Try adjusting your filters or check back later for new products.</p>
                        <a href="/" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-lg hover:shadow-lg transition">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                            Back to Home
                        </a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>

    <script>
        // Sort functionality
        document.getElementById('sortBy').addEventListener('change', function(e) {
            const sortValue = e.target.value;
            console.log('Sorting by:', sortValue);
            // You can implement sorting logic here
        });

        // Stock filter
        document.querySelectorAll('.stock-filter').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                console.log('Filter changed');
                // You can implement filtering logic here
            });
        });
    </script>
</body>
</html>