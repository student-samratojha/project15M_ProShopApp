<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Feedback - ProShop Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-slate-50 to-blue-50 min-h-screen">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-blue-600">ProShop Admin</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Welcome, <%= admin.name %></span>
                    <a href="/admin/dashboard" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-10">
            <h1 class="text-4xl font-bold text-gray-900">Manage Feedbacks</h1>
            <p class="text-gray-600 text-lg">Review and respond to customer suggestions</p>
        </div>

        <% if (feedbacks && feedbacks.length > 0) { %>
            <div class="grid grid-cols-1 gap-6">
                <% feedbacks.forEach(function(feedback) { %>
                    <div class="bg-white rounded-2xl shadow-lg border border-blue-100 overflow-hidden hover:shadow-xl transition duration-300">
                        <div class="p-6">
                            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                                <div class="flex items-center gap-4">
                                    <div class="w-16 h-16 rounded-full overflow-hidden border-2 border-blue-100 bg-blue-50 flex items-center justify-center text-xl font-bold text-blue-600 flex-shrink-0">
                                        <% if (feedback.profilePic) { %>
                                            <img src="<%= feedback.profilePic %>" alt="<%= feedback.name %>" class="w-full h-full object-cover" />
                                        <% } else { %>
                                            <span><%= feedback.name ? feedback.name.charAt(0).toUpperCase() : 'U' %></span>
                                        <% } %>
                                    </div>
                                    <div>
                                        <h2 class="text-xl font-bold text-gray-900">
                                            <%= feedback.name %>
                                        </h2>
                                        <p class="text-blue-600 font-medium text-sm">
                                            <%= feedback.email %>
                                        </p>
                                    </div>
                                </div>
                                <div class="flex items-center gap-4">
                                    <div class="flex items-center bg-yellow-50 px-3 py-1 rounded-full border border-yellow-200">
                                        <span class="text-yellow-600 font-bold mr-1"><%= feedback.rating %></span>
                                        <svg class="w-4 h-4 text-yellow-500 fill-current" viewBox="0 0 20 20">
                                            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                                        </svg>
                                    </div>
                                    <p class="text-xs text-gray-400 font-medium italic">
                                        <%= new Date(feedback.createdAt).toLocaleDateString() %>
                                    </p>
                                </div>
                            </div>

                            <div class="bg-slate-50 rounded-xl p-5 border border-slate-100 mb-6">
                                <p class="text-gray-700 leading-relaxed italic">
                                    <%= feedback.message %>
                                </p>
                            </div>

                            <div class="flex justify-end pt-4 border-t border-gray-100">
                                <form action="/admin/feedback/delete" method="POST" onsubmit="return confirm('Are you sure you want to delete this feedback?')">
                                    <input type="hidden" name="id" value="<%= feedback._id %>">
                                    <button type="submit" class="flex items-center gap-2 px-5 py-2.5 bg-red-50 text-red-600 font-bold rounded-xl hover:bg-red-500 hover:text-white transition duration-300 shadow-sm">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                        </svg>
                                        Delete Entry
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="bg-white rounded-3xl p-16 shadow-xl text-center border-2 border-dashed border-blue-100">
                <svg class="w-20 h-20 text-blue-200 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                <h3 class="text-3xl font-bold text-gray-900 mb-3">No Feedback Found</h3>
                <p class="text-gray-600 mb-8 text-lg">Customers haven't submitted any feedback yet.</p>
                <a href="/admin/dashboard" class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-2xl hover:shadow-xl transition transform hover:scale-105">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Go to Dashboard
                </a>
            </div>
        <% } %>
    </div>
    <footer class="py-10 text-center text-gray-400 text-xs">
        <p>&copy; 2024 ProShop Admin Portal. Feedback Management System.</p>
    </footer>
</body>
</html>