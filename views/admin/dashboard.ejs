<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-slate-50 to-blue-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-blue-600">ProShop Admin</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Welcome, <%= admin.name %></span>
                    <a href="/" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Home</a>
                    <a href="/secure/create" class="px-4 py-2 bg-orange-100 text-orange-700 rounded-lg font-semibold hover:bg-orange-200 transition">Add Employee</a>
                    <a href="/bookings/all" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">All Bookings</a>
                    <a href="/secure/edit" class="px-4 py-2 bg-indigo-100 text-indigo-700 rounded-lg font-semibold hover:bg-indigo-200 transition">Edit Profile</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <!-- Header -->
        <div class="grid gap-6 mb-12 lg:grid-cols-[auto_1fr] items-center">
            <div class="flex items-center gap-4 bg-white rounded-2xl shadow-lg p-6">
                <div class="w-20 h-20 rounded-full overflow-hidden border-4 border-blue-100 bg-white shadow-sm flex items-center justify-center text-3xl font-bold text-blue-700 flex-shrink-0">
                    <% if (admin.avatar) { %>
                        <img src="<%= admin.avatar %>" alt="<%= admin.name %> Avatar" class="w-full h-full object-cover" />
                    <% } else { %>
                        <span><%= admin.name ? admin.name.charAt(0).toUpperCase() : 'A' %></span>
                    <% } %>
                </div>
                <div class="min-w-0">
                    <h2 class="text-2xl font-bold text-gray-900 truncate"><%= admin.name %></h2>
                    <p class="text-sm text-gray-500 mt-1 capitalize">Admin dashboard</p>
                </div>
            </div>
            <div class="rounded-2xl bg-gradient-to-r from-blue-100 to-blue-200 p-6 shadow-lg">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Admin Dashboard</h1>
                <p class="text-gray-600 text-base">Manage your entire system</p>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <!-- Total Users -->
            <div class="bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-800 font-semibold text-sm mb-1">Total Users</p>
                        <p class="text-3xl font-bold text-blue-900"><%= users.length %></p>
                    </div>
                    <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10h.01M11 20h4m-4-8a3 3 0 110-6 3 3 0 010 6zm8 0a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Active Users -->
            <div class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-800 font-semibold text-sm mb-1">Active Users</p>
                        <p class="text-3xl font-bold text-green-900"><%= users.filter(u => u.isActive).length %></p>
                    </div>
                    <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Inactive Users -->
            <div class="bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-800 font-semibold text-sm mb-1">Inactive Users</p>
                        <p class="text-3xl font-bold text-yellow-900"><%= users.filter(u => !u.isActive).length %></p>
                    </div>
                    <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4v.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Recent Audits -->
            <div class="bg-gradient-to-br from-red-100 to-red-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-red-800 font-semibold text-sm mb-1">Recent Activities</p>
                        <p class="text-3xl font-bold text-red-900"><%= audits.length %></p>
                    </div>
                    <div class="w-12 h-12 bg-red-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Users Section -->
        <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center space-x-2">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10h.01M11 20h4m-4-8a3 3 0 110-6 3 3 0 010 6zm8 0a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span>All Users</span>
            </h2>

            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-gradient-to-r from-blue-100 to-blue-200">
                                <th class="px-6 py-4 text-left text-sm font-bold text-blue-900">Name</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-blue-900">Email</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-blue-900">Role</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-blue-900">Status</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-blue-900">Phone</th>                                    <th class="px-6 py-4 text-left text-sm font-bold text-blue-900">Action</th>                            </tr>
                        </thead>
                        <tbody>
                            <% users.forEach((user, index) => { %>
                                <tr class="border-b border-gray-200 hover:bg-blue-50 transition">
                                    <td class="px-6 py-4 font-semibold text-gray-900"><%= user.name %></td>
                                    <td class="px-6 py-4 text-gray-700"><%= user.email %></td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold 
                                            <% if(user.role === 'admin') { %>
                                                bg-red-100 text-red-700
                                            <% } else if(user.role === 'employee') { %>
                                                bg-green-100 text-green-700
                                            <% } else { %>
                                                bg-yellow-100 text-yellow-700
                                            <% } %>
                                        ">
                                            <%= user.role %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold 
                                            <% if(user.isActive) { %>
                                                bg-green-100 text-green-700
                                            <% } else { %>
                                                bg-red-100 text-red-700
                                            <% } %>
                                        ">
                                            <%= user.isActive ? 'Active' : 'Inactive' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-700"><%= user.phone || 'N/A' %></td>
                                    <td class="px-6 py-4">
                                        <% if (user._id.toString() !== admin._id.toString()) { %>
                                            <% if (user.isActive) { %>
                                                <form action="/secure/deactivate-account" method="POST" class="inline-block">
                                                    <input type="hidden" name="id" value="<%= user._id %>">
                                                    <button type="submit" class="px-3 py-1 bg-yellow-100 text-yellow-700 rounded-full text-xs font-semibold hover:bg-yellow-200 transition">Deactivate</button>
                                                </form>
                                            <% } else { %>
                                                <form action="/secure/reactivate-account" method="POST" class="inline-block">
                                                    <input type="hidden" name="id" value="<%= user._id %>">
                                                    <button type="submit" class="px-3 py-1 bg-green-100 text-green-700 rounded-full text-xs font-semibold hover:bg-green-200 transition">Activate</button>
                                                </form>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-xs text-gray-500">Self</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

     <!-- Bookings Section -->
<div class="mb-12">

    <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center space-x-2">

        <svg class="w-6 h-6 text-green-600"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24">

            <path stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
            </path>

        </svg>

        <span>All Bookings</span>

    </h2>

    <div class="bg-white rounded-2xl shadow-lg overflow-hidden">

        <div class="overflow-x-auto">

            <table class="w-full min-w-[1200px]">

                <thead>

                    <tr class="bg-gradient-to-r from-green-100 to-green-200">

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Customer
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Product
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Quantity
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Total Price
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Status
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Assigned Employee
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Delivery Date
                        </th>

                        <th class="px-6 py-4 text-left text-sm font-bold text-green-900">
                            Assign Employee
                        </th>

                    </tr>

                </thead>

                <tbody>

                    <% if (bookings && bookings.length > 0) { %>

                        <% bookings.forEach((booking) => { %>

                            <tr class="border-b border-gray-200 hover:bg-green-50 transition">

                                <!-- Customer -->
                                <td class="px-6 py-4">

                                    <div>

                                        <p class="font-bold text-gray-900">
                                            <%= booking.user ? booking.user.name : 'Unknown' %>
                                        </p>

                                        <p class="text-sm text-gray-500">
                                            <%= booking.user ? booking.user.email : '' %>
                                        </p>

                                    </div>

                                </td>

                                <!-- Product -->
                                <td class="px-6 py-4">

                                    <div>

                                        <p class="font-semibold text-gray-900">
                                            <%= booking.product ? booking.product.name : 'Unknown Product' %>
                                        </p>

                                       
                                    </div>

                                </td>

                                <!-- Quantity -->
                                <td class="px-6 py-4 font-semibold text-gray-700">
                                    <%= booking.quantity %>
                                </td>

                                <!-- Total -->
                                <td class="px-6 py-4">

                                    <span class="text-lg font-bold text-green-700">
                                        ₹<%= booking.totalPrice %>
                                    </span>

                                </td>

                                <!-- Status -->
                                <td class="px-6 py-4">

                                    <span class="px-3 py-1 rounded-full text-xs font-bold

                                        <% if(booking.status === 'pending') { %>
                                            bg-yellow-100 text-yellow-700
                                        <% } else if(booking.status === 'confirmed') { %>
                                            bg-green-100 text-green-700
                                        <% } else if(booking.status === 'delivered') { %>
                                            bg-blue-100 text-blue-700
                                        <% } else if(booking.status === 'cancelled') { %>
                                            bg-red-100 text-red-700
                                        <% } %>

                                    ">

                                        <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>

                                    </span>

                                </td>

                                <!-- Assigned Employee -->
                                <td class="px-6 py-4">

                                    <% if (booking.assignedTo) { %>

                                       
                                            <p class="font-bold text-purple-700">
                                               <%= booking.assignedTo.name %>
                                            </p>

                                        

                                    <% } else { %>

                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-gray-100 text-gray-700">
                                            Unassigned
                                        </span>

                                    <% } %>

                                </td>

                                <!-- Delivery Date -->
                                <td class="px-6 py-4 text-gray-700 font-medium">

                                    <%= booking.deliveryDate
                                        ? new Date(booking.deliveryDate).toLocaleDateString()
                                        : 'N/A' %>

                                </td>

                                <!-- Assign -->
                                <td class="px-6 py-4">
<%if(booking.assignedTo){%>
<p class=' font-semibold text-green-700 '>Assigned</p>
<%} else{%>
                                    <form action="/bookings/assign" method="POST" class="space-y-3 gap-1 flex itmes-center">

                                        <input type="hidden"
                                            name="id"
                                            value="<%= booking._id %>">

                                        <!-- Employee List -->
                                        <select
                                            name="employeeId"
                                            required
                                            class="w-full px-4 py-1 border-2 border-blue-100 rounded-xl bg-blue-50 focus:outline-none focus:border-blue-400 text-sm">

                                            <option value="">
                                                Select
                                            </option>

                                            <% if (employees && employees.length > 0) { %>

                                                <% employees.forEach((employee) => { %>

                                                    <option
                                                        value="<%= employee._id %>"

                                                        <%= booking.assignedTo &&
                                                            booking.assignedTo._id.toString() === employee._id.toString()
                                                            ? 'selected'
                                                            : '' %>
                                                    >

                                                        <%= employee.name %> -
                                                        <%= employee.email %>

                                                    </option>

                                                <% }) %>

                                            <% } %>

                                        </select>

                                        <!-- Assign Button -->
                                        <button type="submit"
                                            class="w-full px-4 py-1 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-semibold rounded-xl hover:shadow-lg transition">

                                            Assign

                                        </button>

                                    </form>
<%}%>
                                </td>

                            </tr>

                        <% }); %>

                    <% } else { %>

                        <tr>

                            <td colspan="8"
                                class="px-6 py-8 text-center text-gray-500">

                                <p class="text-lg font-semibold">
                                    No bookings found
                                </p>

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </div>

</div>

        <!-- Recent Activities Section -->
        <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center space-x-2">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                <span>Recent Activities</span>
            </h2>

            <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead>
                            <tr class="bg-gradient-to-r from-red-100 to-red-200">
                                <th class="px-6 py-4 text-left text-sm font-bold text-red-900">User</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-red-900">Action</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-red-900">Description</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-red-900">Status</th>
                                <th class="px-6 py-4 text-left text-sm font-bold text-red-900">Time</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% audits.slice(0, 10).forEach((audit) => { %>
                                <tr class="border-b border-gray-200 hover:bg-red-50 transition">
                                    <td class="px-6 py-4 font-semibold text-gray-900"><%= audit.user?.name || 'System' %></td>
                                    <td class="px-6 py-4 text-gray-700"><%= audit.action %></td>
                                    <td class="px-6 py-4 text-gray-700 max-w-xs truncate"><%= audit.message %></td>
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold 
                                            <% if(audit.isSuccess) { %>
                                                bg-green-100 text-green-700
                                            <% } else { %>
                                                bg-red-100 text-red-700
                                            <% } %>
                                        ">
                                            <%= audit.isSuccess ? 'Success' : 'Failed' %>
                                        </span>
                                    </td>
                                    <td class="px-6 py-4 text-gray-700"><%= new Date(audit.createdAt).toLocaleDateString() %></td>
                                </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Assign Modal -->
    <div id="assignModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-8">
            <h3 class="text-2xl font-bold text-gray-900 mb-6">Assign Booking to Employee</h3>
            
            <form action="/booking/assign" method="POST" id="assignForm">
                <input type="hidden" name="id" id="bookingId">
                
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">Select Employee</label>
                    <select name="employeeId" id="employeeSelect" class="w-full px-4 py-3 border-2 border-blue-100 rounded-lg focus:border-blue-400 bg-blue-50" required>
                        <option value="">-- Choose Employee --</option>
                    </select>
                </div>

                <div class="flex gap-4">
                    <button type="button" onclick="closeAssignModal()" class="flex-1 px-4 py-3 border-2 border-gray-300 text-gray-700 font-bold rounded-lg hover:bg-gray-50 transition">
                        Cancel
                    </button>
                    <button type="submit" class="flex-1 px-4 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-lg hover:shadow-lg transition">
                        Assign
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Employees list from backend
        const employees = <%= JSON.stringify(typeof employees !== 'undefined' ? employees : []) %>;

        function openAssignModal(bookingId) {
            document.getElementById('bookingId').value = bookingId;
            document.getElementById('assignModal').classList.remove('hidden');
            
            // Populate employee dropdown
            const selectElement = document.getElementById('employeeSelect');
            selectElement.innerHTML = '<option value="">-- Choose Employee --</option>';
            
            if (employees && employees.length > 0) {
                employees.forEach(emp => {
                    const option = document.createElement('option');
                    option.value = emp._id;
                    option.textContent = emp.name + ' (' + emp.email + ')';
                    selectElement.appendChild(option);
                });
            } else {
                const option = document.createElement('option');
                option.value = '';
                option.textContent = '-- No employees available --';
                option.disabled = true;
                selectElement.appendChild(option);
            }
        }

        function closeAssignModal() {
            document.getElementById('assignModal').classList.add('hidden');
        }

        // Close modal when clicking outside
        document.getElementById('assignModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeAssignModal();
            }
        });
    </script>
</body>
</html>
