<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Employee - ProShop Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-slate-50 to-blue-50">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-blue-600">ProShop Admin</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/admin/dashboard" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
            <div class="bg-gradient-to-r from-blue-100 to-blue-200 px-10 py-10">
                <h1 class="text-4xl font-bold text-blue-900 mb-2">Create New Employee</h1>
                <p class="text-gray-600">Add a new employee account with access to create products and manage categories.</p>
            </div>
            <div class="p-10">
                <form action="/admin/employee/create" method="POST" class="grid gap-6 lg:grid-cols-2">
                    <div>
                        <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Full Name</label>
                        <input type="text" id="name" name="name" placeholder="John Doe" required class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-500 focus:outline-none bg-blue-50">
                    </div>

                    <div>
                        <label for="username" class="block text-sm font-semibold text-gray-700 mb-2">Username</label>
                        <input type="text" id="username" name="username" placeholder="johndoe" required class="w-full px-4 py-3 border-2 border-yellow-100 rounded-2xl focus:border-yellow-500 focus:outline-none bg-yellow-50">
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
                        <input type="email" id="email" name="email" placeholder="john@example.com" required class="w-full px-4 py-3 border-2 border-green-100 rounded-2xl focus:border-green-500 focus:outline-none bg-green-50">
                    </div>

                    <div>
                        <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
                        <input type="tel" id="phone" name="phone" placeholder="+91 99999 99999" class="w-full px-4 py-3 border-2 border-red-100 rounded-2xl focus:border-red-500 focus:outline-none bg-red-50">
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">Password</label>
                        <input type="password" id="password" name="password" placeholder="••••••••" required class="w-full px-4 py-3 border-2 border-indigo-100 rounded-2xl focus:border-indigo-500 focus:outline-none bg-indigo-50">
                    </div>

                    <div>
                        <label for="avatar" class="block text-sm font-semibold text-gray-700 mb-2">Avatar URL</label>
                        <input type="url" id="avatar" name="avatar" placeholder="https://example.com/avatar.jpg" class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-500 focus:outline-none bg-blue-50">
                    </div>

                    <div>
                        <label for="gender" class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                        <select id="gender" name="gender" class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-500 focus:outline-none bg-blue-50">
                            <option value="">Select Gender</option>
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                            <option value="other">Other</option>
                        </select>
                    </div>

                    <div>
                        <label for="dateOfBirth" class="block text-sm font-semibold text-gray-700 mb-2">Date of Birth</label>
                        <input type="date" id="dateOfBirth" name="dateOfBirth" class="w-full px-4 py-3 border-2 border-green-100 rounded-2xl focus:border-green-500 focus:outline-none bg-green-50">
                    </div>

                    <div class="lg:col-span-2">
                        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
                            <a href="/admin/dashboard" class="inline-flex items-center justify-center px-6 py-3 border-2 border-blue-300 text-blue-700 rounded-2xl font-semibold hover:bg-blue-50 transition">
                                Cancel
                            </a>
                            <button type="submit" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-2xl hover:shadow-lg transition">
                                Create Employee
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>