<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-blue-50 to-slate-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-blue-600">ProShop</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/" class="text-gray-700 hover:text-blue-600 font-semibold">Home</a>
                    <a href="/about" class="text-gray-700 hover:text-blue-600 font-semibold">About</a>
                    <a href="/contact" class="text-blue-600 font-semibold border-b-2 border-blue-600">Contact</a>
                    <% if (user) { %>
                        <span class="text-gray-700 font-medium">Welcome, <%= user.name %></span>
                        <% if (user.role === 'admin') { %>
                            <a href="/secure/admin" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Admin Panel</a>
                        <% } else if (user.role === 'employee') { %>
                            <a href="/secure/employee" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Employee Panel</a>
                        <% } else { %>
                            <a href="/secure/customer" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Dashboard</a>
                        <% } %>
                        <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                    <% } else { %>
                        <a href="/auth/login" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Login</a>
                        <a href="/auth/register" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Register</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center mb-16">
            <h1 class="text-5xl lg:text-6xl font-bold text-gray-900 mb-6">Get in Touch</h1>
            <p class="text-xl text-gray-600 max-w-3xl mx-auto">Have questions or feedback? We'd love to hear from you. Our team is here to help and will respond as soon as possible.</p>
        </div>
    </section>

    <!-- Contact Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Contact Information -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Address Card -->
                <div class="bg-blue-100 rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
                    <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-blue-900 mb-3">Office Location</h3>
                    <p class="text-blue-800 font-semibold mb-1">ProShop Headquarters</p>
                    <p class="text-blue-700">123 Business Avenue<br>New York, NY 10001<br>United States</p>
                </div>

                <!-- Phone Card -->
                <div class="bg-green-100 rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
                    <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-green-900 mb-3">Phone Number</h3>
                    <p class="text-green-800 font-semibold mb-2">+1 (555) 123-4567</p>
                    <p class="text-green-700 text-sm">Available Monday - Friday<br>9:00 AM - 6:00 PM EST</p>
                </div>

                <!-- Email Card -->
                <div class="bg-yellow-100 rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
                    <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-yellow-900 mb-3">Email Address</h3>
                    <p class="text-yellow-800 font-semibold mb-1">support@proshop.com</p>
                    <p class="text-yellow-700 text-sm">General inquiries</p>
                    <p class="text-yellow-800 font-semibold mt-3 mb-1">sales@proshop.com</p>
                    <p class="text-yellow-700 text-sm">Sales inquiries</p>
                </div>

                <!-- Hours Card -->
                <div class="bg-red-100 rounded-2xl p-8 shadow-lg hover:shadow-xl transition">
                    <div class="w-12 h-12 bg-red-500 rounded-full flex items-center justify-center mb-4">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                    </div>
                    <h3 class="text-xl font-bold text-red-900 mb-3">Business Hours</h3>
                    <ul class="space-y-2 text-red-800">
                        <li class="flex justify-between">
                            <span class="font-semibold">Monday - Friday:</span>
                            <span>9:00 AM - 6:00 PM</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="font-semibold">Saturday:</span>
                            <span>10:00 AM - 4:00 PM</span>
                        </li>
                        <li class="flex justify-between">
                            <span class="font-semibold">Sunday:</span>
                            <span>Closed</span>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Contact Form -->
            <div class="lg:col-span-2">
                <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
                    <!-- Form Header -->
                    <div class="bg-gradient-to-r from-blue-100 to-blue-200 px-8 py-8">
                        <h2 class="text-3xl font-bold text-blue-900">Send us a Message</h2>
                        <p class="text-blue-800 mt-2">Fill out the form below and we'll get back to you as soon as possible</p>
                    </div>

                    <!-- Form Body -->
                    <form action="#" method="POST" class="p-8 space-y-6">
                        <!-- Name Field -->
                        <div>
                            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Full Name *</label>
                            <div class="relative">
                                <svg class="absolute left-3 top-3.5 w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                                <input type="text" id="name" name="name" placeholder="John Doe" required class="w-full pl-10 pr-4 py-2.5 border-2 border-blue-100 rounded-lg focus:border-blue-500 focus:outline-none transition bg-blue-50">
                            </div>
                        </div>

                        <!-- Email Field -->
                        <div>
                            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address *</label>
                            <div class="relative">
                                <svg class="absolute left-3 top-3.5 w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                                </svg>
                                <input type="email" id="email" name="email" placeholder="you@example.com" required class="w-full pl-10 pr-4 py-2.5 border-2 border-green-100 rounded-lg focus:border-green-500 focus:outline-none transition bg-green-50">
                            </div>
                        </div>

                        <!-- Phone Field -->
                        <div>
                            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
                            <div class="relative">
                                <svg class="absolute left-3 top-3.5 w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                                </svg>
                                <input type="tel" id="phone" name="phone" placeholder="+1 (555) 000-0000" class="w-full pl-10 pr-4 py-2.5 border-2 border-yellow-100 rounded-lg focus:border-yellow-500 focus:outline-none transition bg-yellow-50">
                            </div>
                        </div>

                        <!-- Subject Field -->
                        <div>
                            <label for="subject" class="block text-sm font-semibold text-gray-700 mb-2">Subject *</label>
                            <div class="relative">
                                <svg class="absolute left-3 top-3.5 w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
                                </svg>
                                <input type="text" id="subject" name="subject" placeholder="How can we help?" required class="w-full pl-10 pr-4 py-2.5 border-2 border-red-100 rounded-lg focus:border-red-500 focus:outline-none transition bg-red-50">
                            </div>
                        </div>

                        <!-- Category Field -->
                        <div>
                            <label for="category" class="block text-sm font-semibold text-gray-700 mb-2">Category *</label>
                            <select id="category" name="category" required class="w-full px-4 py-2.5 border-2 border-blue-100 rounded-lg focus:border-blue-500 focus:outline-none transition bg-blue-50">
                                <option value="">-- Select a Category --</option>
                                <option value="general">General Inquiry</option>
                                <option value="support">Technical Support</option>
                                <option value="sales">Sales Question</option>
                                <option value="feedback">Feedback</option>
                                <option value="partnership">Partnership</option>
                                <option value="other">Other</option>
                            </select>
                        </div>

                        <!-- Message Field -->
                        <div>
                            <label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Message *</label>
                            <textarea id="message" name="message" rows="5" placeholder="Tell us more about your inquiry..." required class="w-full px-4 py-2.5 border-2 border-green-100 rounded-lg focus:border-green-500 focus:outline-none transition bg-green-50 resize-none"></textarea>
                        </div>

                        <!-- Checkbox -->
                        <label class="flex items-center space-x-3 cursor-pointer">
                            <input type="checkbox" name="subscribe" class="w-4 h-4 text-blue-600 rounded focus:ring-2 focus:ring-blue-500">
                            <span class="text-sm text-gray-700">I'd like to receive updates and news from ProShop</span>
                        </label>

                        <!-- Submit Button -->
                        <button type="submit" class="w-full py-3 bg-gradient-to-r from-blue-500 to-blue-600 text-white font-bold rounded-lg hover:shadow-lg transition transform hover:scale-105 flex items-center justify-center space-x-2 mt-6">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                            </svg>
                            <span>Send Message</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Section -->
    <section class="bg-white py-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
                <h2 class="text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h2>
                <p class="text-xl text-gray-600">Find quick answers to common questions</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                <!-- FAQ Item 1 -->
                <div class="bg-blue-100 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-blue-900 mb-2">What is ProShop?</h3>
                            <p class="text-blue-800">ProShop is a comprehensive product management system designed to help businesses organize, manage, and optimize their product catalogs efficiently.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 2 -->
                <div class="bg-green-100 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-green-900 mb-2">How do I get started?</h3>
                            <p class="text-green-800">Simply sign up for a free account on our website. You'll get instant access to all basic features and can start managing your products immediately.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 3 -->
                <div class="bg-yellow-100 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-yellow-500 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-yellow-900 mb-2">Is my data secure?</h3>
                            <p class="text-yellow-800">Yes! We use enterprise-grade security with encrypted data, secure authentication, and regular backups to ensure your data is always protected.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 4 -->
                <div class="bg-red-100 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-red-500 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-red-900 mb-2">What is the pricing?</h3>
                            <p class="text-red-800">We offer flexible pricing plans for businesses of all sizes. Contact our sales team to discuss a plan that fits your needs.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 5 -->
                <div class="bg-blue-100 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-blue-900 mb-2">Do you offer training?</h3>
                            <p class="text-blue-800">Yes! We provide comprehensive training, documentation, and video tutorials to help you get the most out of ProShop.</p>
                        </div>
                    </div>
                </div>

                <!-- FAQ Item 6 -->
                <div class="bg-green-100 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                    <div class="flex items-start space-x-4">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                        </div>
                        <div>
                            <h3 class="text-lg font-bold text-green-900 mb-2">How do I contact support?</h3>
                            <p class="text-green-800">You can reach our support team via email, phone, or through the contact form on this page. We typically respond within 24 hours.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Social Proof Section -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
        <div class="text-center mb-16">
            <h2 class="text-4xl font-bold text-gray-900 mb-4">Get in Touch Today</h2>
            <p class="text-xl text-gray-600">We're here to help and answer any question you might have</p>
        </div>

        <div class="bg-gradient-to-r from-blue-100 via-green-100 to-blue-100 rounded-3xl p-12">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center">
                <div>
                    <div class="text-4xl font-bold text-blue-900 mb-2">99.9%</div>
                    <p class="text-blue-800">System Uptime Guarantee</p>
                </div>
                <div>
                    <div class="text-4xl font-bold text-green-900 mb-2">24/7</div>
                    <p class="text-green-800">Customer Support Available</p>
                </div>
                <div>
                    <div class="text-4xl font-bold text-yellow-900 mb-2">1000+</div>
                    <p class="text-yellow-800">Happy Customers Worldwide</p>
                </div>
            </div>
        </div>
    </section>
    <!-- Footer -->
    <footer class="bg-white border-t border-gray-200 mt-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-5">
            
                    <div class="flex items-center space-x-2 mb-4">
                        <div class="w-8 h-8 bg-gradient-to-br from-blue-500 to-blue-600 rounded-lg"></div>
                        <span class="font-bold text-blue-600">ProShop</span>
                    </div>
                    <p class="text-gray-600 text-sm">The ultimate product management solution for modern businesses</p>
                
            </div>
            <div class="border-t border-gray-200 pt-4 text-center text-gray-600 text-sm">
                <p>&copy; 2026 ProShop. All rights reserved. Built with passion for better product management.</p>
            </div>
        </div>
    </footer>
  
</body>
</html>
