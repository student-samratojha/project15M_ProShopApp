<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product - <%= product.name %></title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-slate-50 to-green-50 min-h-screen">
    <!-- Navigation (Individual Page Navbar) -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-green-600">ProShop Employee</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Welcome, <%= user.name %></span>
                    <a href="/" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Home</a>
                    <a href="/employee/bookings/manage" class="px-4 py-2 bg-orange-100 text-orange-700 rounded-lg font-semibold hover:bg-orange-200 transition">Manage Bookings</a>
                    <a href="/employee/products/manage" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Manage Products</a>
                    <a href="/user/edit" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Edit Profile</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-5xl mx-auto px-4 py-12">
        <!-- Header -->
        <div class="mb-12">
            <div class="rounded-2xl bg-gradient-to-r from-green-100 to-green-200 p-8 shadow-lg">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Edit Product</h1>
                <p class="text-gray-600 text-lg">Update details for product: <span class="font-bold text-green-700"><%= product.name %></span></p>
            </div>
        </div>

        <!-- Form Content -->
        <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-green-100 p-8">
            <form action="/employee/products/edit" method="POST" class="space-y-8">
                <!-- Hidden Identifiers -->
                <input type="hidden" name="id" value="<%= product._id %>">
                <input type="hidden" name="category" value="<%= product.category._id || product.category %>">

                <!-- Section: Basic Information -->
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Basic Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Name</label>
                            <input type="text" name="name" value="<%= product.name %>" required
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900 font-medium">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Slug (URL Name)</label>
                            <input type="text" name="slug" value="<%= product.slug %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Short Description</label>
                        <textarea name="shortDescription" rows="2"
                            class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900"><%= product.shortDescription %></textarea>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Full Description</label>
                        <textarea name="description" rows="4"
                            class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900"><%= product.description %></textarea>
                    </div>
                </div>

                <!-- Section: Inventory & Pricing -->
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Inventory & Pricing</h3>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Price (₹)</label>
                            <input type="number" name="price" value="<%= product.price %>" step="0.01" required
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900 font-bold">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Discount Price (₹)</label>
                            <input type="number" name="discountPrice" value="<%= product.discountPrice %>" step="0.01"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Stock Level</label>
                            <input type="number" name="stock" value="<%= product.stock %>" required
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900 font-bold">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">SKU</label>
                            <input type="text" name="sku" value="<%= product.sku %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Brand</label>
                            <input type="text" name="brand" value="<%= product.brand %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                    </div>
                </div>

                <!-- Section: Media & Attributes -->
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Media & Attributes</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Thumbnail URL</label>
                            <input type="text" name="thumbnail" value="<%= product.thumbnail %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Images (Comma separated URLs)</label>
                            <input type="text" name="images" value="<%= product.images ? product.images.join(', ') : '' %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Colors</label>
                            <input type="text" name="colors" value="<%= product.colors ? product.colors.join(', ') : '' %>" placeholder="Red, Blue..."
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Sizes</label>
                            <input type="text" name="sizes" value="<%= product.sizes ? product.sizes.join(', ') : '' %>" placeholder="S, M, L..."
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Tags</label>
                            <input type="text" name="tags" value="<%= product.tags ? product.tags.join(', ') : '' %>" placeholder="New, Sale..."
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                    </div>
                </div>

                <!-- Section: Shipping & Policies -->
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Logistics & Policies</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Weight (kg)</label>
                            <input type="number" name="weight" value="<%= product.weight %>" step="0.01"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Shipping Charge (₹)</label>
                            <input type="number" name="shippingCharge" value="<%= product.shippingCharge %>" step="0.01"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900 font-semibold">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Warranty</label>
                            <input type="text" name="warranty" value="<%= product.warranty %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Return Policy</label>
                            <input type="text" name="returnPolicy" value="<%= product.returnPolicy %>"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                        </div>
                    </div>
                </div>

                <!-- Section: SEO -->
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Search Engine Optimization</h3>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Meta Title</label>
                        <input type="text" name="metaTitle" value="<%= product.metaTitle %>"
                            class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900">
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Meta Description</label>
                        <textarea name="metaDescription" rows="2"
                            class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 focus:outline-none bg-green-50 text-gray-900"><%= product.metaDescription %></textarea>
                    </div>
                </div>

                <!-- Section: Toggles & Status -->
                <div class="bg-green-50 p-6 rounded-2xl border-2 border-green-100 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" name="isFeatured" id="isFeatured" <%= product.isFeatured ? 'checked' : '' %> value="true"
                            class="w-5 h-5 rounded text-green-600 focus:ring-green-500">
                        <label for="isFeatured" class="text-sm font-bold text-gray-700 cursor-pointer">Featured Product</label>
                    </div>
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" name="isAvailable" id="isAvailable" <%= product.isAvailable ? 'checked' : '' %> value="true"
                            class="w-5 h-5 rounded text-green-600 focus:ring-green-500">
                        <label for="isAvailable" class="text-sm font-bold text-gray-700 cursor-pointer">Available for Sale</label>
                    </div>
                    <div>
                        <select name="status" class="w-full px-4 py-2 border-2 border-white rounded-xl focus:outline-none bg-white font-bold text-gray-900">
                            <option value="active" <%= product.status === 'active' ? 'selected' : '' %>>Active</option>
                            <option value="inactive" <%= product.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                        </select>
                    </div>
                </div>

                <!-- Submit Buttons -->
                <div class="flex flex-col sm:flex-row gap-4 pt-6">
                    <button type="submit"
                        class="flex-1 py-4 bg-gradient-to-r from-green-500 to-green-600 text-white font-bold rounded-2xl hover:shadow-lg transition transform hover:scale-[1.02]">
                        Update Product
                    </button>
                    <a href="/employee/products/manage"
                        class="flex-1 py-4 bg-gray-200 text-gray-800 font-bold rounded-2xl hover:bg-gray-300 transition text-center">
                        Cancel Changes
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>