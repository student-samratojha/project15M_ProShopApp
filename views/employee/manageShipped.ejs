<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Tracking - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-slate-50 to-indigo-50 min-h-screen">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-indigo-500 to-indigo-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <span class="text-2xl font-bold text-indigo-600">ProShop Employee</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/employee/dashboard" class="px-4 py-2 bg-indigo-100 text-indigo-700 rounded-lg font-semibold hover:bg-indigo-200 transition">Dashboard</a>
                    <a href="/employee/bookings/manage" class="px-4 py-2 bg-purple-100 text-purple-700 rounded-lg font-semibold hover:bg-purple-200 transition">Assigned Bookings</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-10">
            <h1 class="text-4xl font-bold text-gray-900">Live Shipment Tracking</h1>
            <p class="text-gray-600 text-lg">Update real-time location and status logs for shipped orders.</p>
        </div>

        <% if (shipped && shipped.length > 0) { %>
            <div class="grid grid-cols-1 gap-8">
                <% shipped.forEach(shipment => { %>
                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-indigo-100 grid grid-cols-1 lg:grid-cols-3">
                        <!-- Left: Info -->
                        <div class="p-8 bg-slate-50 border-r border-indigo-50">
                            <h2 class="text-xl font-bold text-indigo-900 mb-4">Order Info</h2>
                            <div class="space-y-4 text-sm">
                                <p><span class="text-gray-500 block">Product</span> <span class="font-bold text-gray-900"><%= shipment.booking ? shipment.booking.product.name : 'Unknown' %></span></p>
                                <p><span class="text-gray-500 block">Destination Hub</span> <span class="font-bold text-gray-900"><%= shipment.deliveryCity %></span></p>
                                <p><span class="text-gray-500 block">Current Status</span> 
                                    <span class="px-3 py-1 bg-indigo-100 text-indigo-700 rounded-full font-bold uppercase text-[10px]"><%= shipment.status.replace(/_/g, ' ') %></span>
                                </p>
                                <div class="pt-4 mt-4 border-t border-indigo-100">
                                    <h3 class="font-bold text-indigo-800 mb-2">Tracking Logs</h3>
                                    <div class="max-h-40 overflow-y-auto space-y-2 pr-2">
                                        <% shipment.trackingLogs.reverse().forEach(log => { %>
                                            <div class="bg-white p-2 rounded-lg border border-indigo-100 text-[11px]">
                                                <p class="font-bold text-gray-800"><%= log.city %> - <%= log.status %></p>
                                                <p class="text-gray-500"><%= new Date(log.time).toLocaleString() %></p>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Right: Update Form -->
                        <div class="lg:col-span-2 p-8">
                            <h2 class="text-xl font-bold text-gray-900 mb-6">Log New Movement</h2>
                            <form action="/employee/ship/update" method="POST" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <input type="hidden" name="id" value="<%= shipment._id %>">
                                
                                <div>
                                    <label class="block text-xs font-bold text-indigo-700 uppercase mb-2">Current City</label>
                                    <input type="text" name="currentCity" required value="<%= shipment.currentCity %>"
                                        class="w-full px-4 py-3 border-2 border-indigo-50 rounded-xl focus:border-indigo-400 outline-none bg-indigo-50 font-bold">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-indigo-700 uppercase mb-2">Detailed Location/Hub</label>
                                    <input type="text" name="currentAddress" required value="<%= shipment.currentAddress %>"
                                        class="w-full px-4 py-3 border-2 border-indigo-50 rounded-xl focus:border-indigo-400 outline-none bg-indigo-50">
                                </div>
                                <div class="md:col-span-2">
                                    <label class="block text-xs font-bold text-indigo-700 uppercase mb-2">Tracking Message</label>
                                    <textarea name="detailes" rows="2" placeholder="e.g. Arrived at sorting facility"
                                        class="w-full px-4 py-3 border-2 border-indigo-50 rounded-xl focus:border-indigo-400 outline-none bg-indigo-50"></textarea>
                                </div>
                                
                                <div class="md:col-span-2 pt-4">
                                    <button type="submit" class="w-full py-4 bg-indigo-600 text-white font-bold rounded-2xl hover:bg-indigo-700 transition shadow-lg">
                                        Update Tracking Status
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <div class="bg-white rounded-3xl p-16 shadow-xl text-center border-2 border-dashed border-indigo-100">
                <div class="w-24 h-24 bg-indigo-100 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-12 h-12 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.856-1.487M15 10h.01M11 20h4m-4-8a3 3 0 110-6 3 3 0 010 6zm8 0a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                </div>
                <h3 class="text-3xl font-bold text-gray-900 mb-3">No Shipments Active</h3>
                <p class="text-gray-600 mb-8 text-lg">Mark an assigned booking as 'Shipped' to start tracking movements here.</p>
                <a href="/employee/bookings/manage" class="inline-flex items-center justify-center px-8 py-4 bg-indigo-600 text-white font-bold rounded-2xl hover:shadow-xl transition transform hover:scale-105">
                    View Assigned Bookings
                </a>
            </div>
        <% } %>
    </div>

    <footer class="py-12 text-center text-gray-400 text-sm">
        <p>&copy; 2024 ProShop Logistics Management.</p>
    </footer>
</body>
</html>