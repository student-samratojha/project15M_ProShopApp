<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employee Dashboard - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-slate-50 to-green-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-green-600">ProShop Employee</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Welcome, <%= user.name %></span>
                    <a href="/" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Home</a>
                    <a href="/bookings/employee/manage" class="px-4 py-2 bg-orange-100 text-orange-700 rounded-lg font-semibold hover:bg-orange-200 transition">Manage Bookings</a>
                    <a href="/products/employee/manage" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Manage Products</a>
                    <a href="/secure/edit" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Edit Profile</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12">
        <!-- Header -->
        <div class="grid gap-6 mb-12 lg:grid-cols-[auto_1fr] items-center">
            <div class="flex items-center gap-4 bg-white rounded-2xl shadow-lg p-6">
                <div class="w-20 h-20 rounded-full overflow-hidden border-4 border-green-100 bg-white shadow-sm flex items-center justify-center text-3xl font-bold text-green-700 flex-shrink-0">
                    <% if (user.avatar) { %>
                        <img src="<%= user.avatar %>" alt="<%= user.name %> Avatar" class="w-full h-full object-cover" />
                    <% } else { %>
                        <span><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></span>
                    <% } %>
                </div>
                <div class="min-w-0">
                    <h2 class="text-2xl font-bold text-gray-900 truncate"><%= user.name %></h2>
                    <p class="text-sm text-gray-500 mt-1 capitalize"><%= user.role %> dashboard</p>
                </div>
            </div>
            <div class="rounded-2xl bg-gradient-to-r from-green-100 to-green-200 p-6 shadow-lg">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Employee Dashboard</h1>
                <p class="text-gray-600 text-base">Manage your products and categories</p>
            </div>
        </div>

        <!-- Action Buttons -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
            <a href="/categories/create" class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-8 shadow-lg hover:shadow-xl transition transform hover:scale-105 text-center">
                <div class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-green-900 mb-2">Create Category</h3>
                <p class="text-green-800">Add a new product category</p>
            </a>

            <a href="/products/create" class="bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl p-8 shadow-lg hover:shadow-xl transition transform hover:scale-105 text-center">
                <div class="w-14 h-14 bg-yellow-500 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-yellow-900 mb-2">Create Product</h3>
                <p class="text-yellow-800">Add a new product to your inventory</p>
            </a>
        </div>

        <!-- Stats Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
            <!-- Categories Count -->
            <div class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-800 font-semibold text-sm mb-1">Total Categories</p>
                        <p class="text-3xl font-bold text-green-900"><% if(category) { %><%= Array.isArray(category) ? category.length : 1 %><% } else { %>0<% } %></p>
                    </div>
                    <div class="w-12 h-12 bg-green-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Products Count -->
            <div class="bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-800 font-semibold text-sm mb-1">Total Products</p>
                        <p class="text-3xl font-bold text-yellow-900"><% if(products) { %><%= Array.isArray(products) ? products.length : 0 %><% } else { %>0<% } %></p>
                    </div>
                    <div class="w-12 h-12 bg-yellow-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V11a2 2 0 012-2z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Assigned Bookings -->
            <div class="bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-purple-800 font-semibold text-sm mb-1">Assigned Bookings</p>
                        <p class="text-3xl font-bold text-purple-900"><% if(bookings) { %><%= Array.isArray(bookings) ? bookings.length : 0 %><% } else { %>0<% } %></p>
                    </div>
                    <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                    </div>
                </div>
            </div>

            <!-- Account Status -->
            <div class="bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-800 font-semibold text-sm mb-1">Account Status</p>
                        <p class="text-3xl font-bold text-blue-900"><%= user.isActive ? 'Active' : 'Inactive' %></p>
                    </div>
                    <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                </div>
            </div>
        </div>

        <!-- Assigned Bookings Section -->
        <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center space-x-2">
                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <span>Your Assigned Bookings</span>
            </h2>

            <% if(bookings && Array.isArray(bookings) && bookings.length > 0) { %>
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-gradient-to-r from-purple-100 to-purple-200">
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Customer</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Product</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Quantity</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Total Price</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Current Status</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Delivery Date</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-purple-900">Update Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% bookings.forEach((booking) => { %>
                                    <tr class="border-b border-gray-200 hover:bg-purple-50 transition">
                                        <td class="px-6 py-4 font-semibold text-gray-900"><%= booking.user ? booking.user.name : 'Unknown' %></td>
                                        <td class="px-6 py-4 text-gray-700"><%= booking.product ? booking.product.name : 'Unknown Product' %></td>
                                        <td class="px-6 py-4 text-gray-700"><%= booking.quantity %></td>
                                        <td class="px-6 py-4 text-gray-700 font-bold">₹<%= booking.totalPrice %></td>
                                        <td class="px-6 py-4">
                                            <span class="px-3 py-1 rounded-full text-xs font-bold 
                                                <% if(booking.status === 'pending') { %>
                                                    bg-yellow-100 text-yellow-700
                                                <% } else if(booking.status === 'confirmed') { %>
                                                    bg-green-100 text-green-700
                                                <% } else if(booking.status === 'in_progress') { %>
                                                    bg-blue-100 text-blue-700
                                                <% } else if(booking.status === 'delivered') { %>
                                                    bg-green-100 text-green-700
                                                <% } else if(booking.status === 'cancelled') { %>
                                                    bg-red-100 text-red-700
                                                <% } %>
                                            ">
                                                <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 text-gray-700"><%= booking.deliveryDate ? new Date(booking.deliveryDate).toLocaleDateString() : 'N/A' %></td>
                                        <td class="px-6 py-4 text-blue-700">
                    <a href="/bookings/employee/manage" class="text-blue-700  font-semibold transition">Manage Bookings</a>
                                            
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="bg-purple-100 border-2 border-purple-300 rounded-2xl p-8 text-center">
                    <svg class="w-16 h-16 text-purple-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <p class="text-purple-800 font-semibold mb-3">No bookings assigned yet</p>
                    <p class="text-purple-700">Wait for the admin to assign bookings to you</p>
                </div>
            <% } %>
        </div>

        <!-- Categories Section -->
        <div class="mb-12">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center space-x-2">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"></path>
                </svg>
                <span>Your Categories</span>
            </h2>

            <% if(category && (Array.isArray(category) ? category.length > 0 : category)) { %>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% if(Array.isArray(category)) { %>
                        <% category.forEach((cat) => { %>
                            <div class="bg-white rounded-2xl shadow-lg hover:shadow-xl transition overflow-hidden border-l-4 border-green-500">
                                <div class="p-6">
                                    <h3 class="text-xl font-bold text-gray-900 mb-2"><%= cat.title %></h3>
                                    <p class="text-gray-600 mb-4 line-clamp-2"><%= cat.description || 'No description' %></p>
                                    <div class="flex items-center space-x-2 mb-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700"><%= cat.status %></span>
                                        <% if(cat.isFeatured) { %>
                                            <span class="px-3 py-1 rounded-full text-xs font-bold bg-yellow-100 text-yellow-700">Featured</span>
                                        <% } %>
                                    </div>
                                    <div class="flex gap-2">
                                        <a href="/categories/edit/<%= cat._id %>" class="flex-1 px-3 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold text-sm hover:bg-blue-200 transition text-center">Edit</a>
                                        <a href="#" class="flex-1 px-3 py-2 bg-red-100 text-red-700 rounded-lg font-semibold text-sm hover:bg-red-200 transition text-center">Delete</a>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } %>
                </div>
            <% } else { %>
                <div class="bg-green-100 border-2 border-green-300 rounded-2xl p-8 text-center">
                    <svg class="w-16 h-16 text-green-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    <p class="text-green-800 font-semibold mb-3">No categories yet</p>
                    <p class="text-green-700 mb-4">Create your first category to get started</p>
                    <a href="/categories/make-category" class="inline-block px-6 py-2 bg-green-500 text-white rounded-lg font-bold hover:bg-green-600 transition">Create Category</a>
                </div>
            <% } %>
        </div>

        <!-- Products Section -->
        <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-6 flex items-center space-x-2">
                <svg class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V11a2 2 0 012-2z"></path>
                </svg>
                <span>Your Products</span>
            </h2>

            <% if(products && Array.isArray(products) && products.length > 0) { %>
                <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full">
                            <thead>
                                <tr class="bg-gradient-to-r from-yellow-100 to-yellow-200">
                                    <th class="px-6 py-4 text-left text-sm font-bold text-yellow-900">Product Name</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-yellow-900">Category</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-yellow-900">Price</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-yellow-900">Status</th>
                                    <th class="px-6 py-4 text-left text-sm font-bold text-yellow-900">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% products.forEach((product) => { %>
                                    <tr class="border-b border-gray-200 hover:bg-yellow-50 transition">
                                        <td class="px-6 py-4 font-semibold text-gray-900"><%= product.name %></td>
                                        <td class="px-6 py-4 text-gray-700"><%= product.category?.title || 'N/A' %></td>
                                        <td class="px-6 py-4 font-bold text-gray-900">$<%= product.price %></td>
                                        <td class="px-6 py-4">
                                            <span class="px-3 py-1 rounded-full text-xs font-bold 
                                                <% if(product.status === 'active') { %>
                                                    bg-green-100 text-green-700
                                                <% } else { %>
                                                    bg-red-100 text-red-700
                                                <% } %>
                                            ">
                                                <%= product.status %>
                                            </span>
                                        </td>
                                        <td class="px-6 py-4 space-x-2">
                                            <a href="/products/edit/<%= product._id %>" class="text-blue-600 hover:text-blue-700 font-semibold">Edit</a>
                                            <a href="#" class="text-red-600 hover:text-red-700 font-semibold">Delete</a>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            <% } else { %>
                <div class="bg-yellow-100 border-2 border-yellow-300 rounded-2xl p-8 text-center">
                    <svg class="w-16 h-16 text-yellow-600 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V11a2 2 0 012-2z"></path>
                    </svg>
                    <p class="text-yellow-800 font-semibold mb-3">No products yet</p>
                    <p class="text-yellow-700 mb-4">Create your first product to get started</p>
                    <a href="/products/make-product" class="inline-block px-6 py-2 bg-yellow-500 text-white rounded-lg font-bold hover:bg-yellow-600 transition">Create Product</a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>
