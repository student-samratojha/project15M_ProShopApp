<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Category - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-slate-50 to-green-50 min-h-screen">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <span class="text-2xl font-bold text-green-600">ProShop Employee</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/employee/dashboard" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Dashboard</a>
                    <a href="/employee/products/manage" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Manage Products</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="mb-12">
            <div class="rounded-2xl bg-gradient-to-r from-green-100 to-green-200 p-8 shadow-lg">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Create New Category</h1>
                <p class="text-gray-600">Define a new brand category for your products.</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-xl border border-green-100 p-8">
            <form action="/employee/categories/create" method="POST" class="space-y-8">
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">General Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Category Title</label>
                            <input type="text" name="title" required placeholder="Electronics, Clothing..."
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Slug (Optional)</label>
                            <input type="text" name="slug" placeholder="electronics-hub"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Description</label>
                        <textarea name="description" rows="3" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50"></textarea>
                    </div>
                </div>

                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Visuals & SEO</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Icon/Image URL</label>
                            <input type="text" name="image" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Banner Image URL</label>
                            <input type="text" name="bannerImage" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Meta Title</label>
                            <input type="text" name="metaTitle" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Keywords (Comma separated)</label>
                            <input type="text" name="keywords" placeholder="keyword1, keyword2"
                                class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                    </div>
                </div>

                <div class="bg-green-50 p-6 rounded-2xl border-2 border-green-100 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
                    <div>
                        <label class="block text-xs font-bold text-green-700 uppercase mb-2">Sort Order</label>
                        <input type="number" name="sortOrder" value="0" class="w-full px-4 py-2 border-2 border-white rounded-xl outline-none bg-white font-bold">
                    </div>
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" name="isFeatured" id="isFeatured" value="true" class="w-5 h-5 rounded text-green-600">
                        <label for="isFeatured" class="text-sm font-bold text-gray-700">Featured Category</label>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-green-700 uppercase mb-2">Status</label>
                        <select name="status" class="w-full px-4 py-2 border-2 border-white rounded-xl outline-none bg-white font-bold">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 pt-6">
                    <button type="submit" class="flex-1 py-4 bg-gradient-to-r from-green-500 to-green-600 text-white font-bold rounded-2xl hover:shadow-lg transition">
                        Create Category
                    </button>
                    <a href="/employee/dashboard" class="flex-1 py-4 bg-gray-200 text-gray-800 font-bold rounded-2xl hover:bg-gray-300 transition text-center flex items-center justify-center">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>