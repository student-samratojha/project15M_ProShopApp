<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - ProShop Employee</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-purple-50 via-slate-50 to-purple-50">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-purple-600">ProShop</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Employee: <%= employee.name %></span>
                    <a href="/employee/dashboard" class="px-4 py-2 bg-purple-100 text-purple-700 rounded-lg font-semibold hover:bg-purple-200 transition">Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900">My Assigned Bookings</h1>
            <p class="text-gray-600 text-lg">Track and manage orders assigned to you</p>
        </div>

        <!-- Stats Cards -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
            <% 
                let totalAssigned = bookings.length;
                let pendingCount = bookings.filter(b => b.status === 'pending').length;
                let inProgressCount = bookings.filter(b => b.status === 'in_progress' || b.status === 'confirmed').length;
                let completedCount = bookings.filter(b => b.status === 'delivered').length;
            %>
            <div class="bg-gradient-to-br from-purple-100 to-purple-200 rounded-2xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-purple-800 text-sm font-semibold">Total Assigned</p>
                        <p class="text-3xl font-bold text-purple-900"><%= totalAssigned %></p>
                    </div>
                    <svg class="w-12 h-12 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                </div>
            </div>

            <div class="bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-yellow-800 text-sm font-semibold">Pending</p>
                        <p class="text-3xl font-bold text-yellow-900"><%= pendingCount %></p>
                    </div>
                    <svg class="w-12 h-12 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>

            <div class="bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-blue-800 text-sm font-semibold">In Progress</p>
                        <p class="text-3xl font-bold text-blue-900"><%= inProgressCount %></p>
                    </div>
                    <svg class="w-12 h-12 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                    </svg>
                </div>
            </div>

            <div class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-6 shadow-lg">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-green-800 text-sm font-semibold">Completed</p>
                        <p class="text-3xl font-bold text-green-900"><%= completedCount %></p>
                    </div>
                    <svg class="w-12 h-12 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Bookings List -->
        <div class="space-y-6">
            <% if (bookings && bookings.length > 0) { %>
                <% bookings.forEach(function(booking) { %>
                    <div class="bg-white rounded-2xl p-6 shadow-lg hover:shadow-xl transition">
                        <div class="grid grid-cols-1 md:grid-cols-5 gap-6 items-start border-b border-gray-100 pb-6 mb-6">
                            <!-- Customer & Product Info -->
                            <div class="md:col-span-2">
                                <h3 class="text-lg font-bold text-gray-900 mb-2">
                                    <%= booking.product ? booking.product.name : 'Unknown Product' %>
                                </h3>
                                <p class="text-sm text-gray-600 mb-3">
                                    <strong>Customer:</strong> <%= booking.user ? booking.user.name : 'Unknown' %>
                                </p>
                                 <p class="text-sm capitalize font-semibold text-green-600 mb-3">
                                    <strong class=" text-gray-600">Payment:</strong> <%= booking.paymentMethod %> (<%=booking.paymentStatus %>)
                                </p>
                                <p class="text-sm text-gray-600">
                                    <strong>Phone:</strong> <%= booking.user && booking.user.phone ? booking.user.phone : 'N/A' %>
                                </p>
                                <p class="text-sm text-gray-600">
                                    <strong>Email:</strong> <%= booking.user && booking.user.email ? booking.user.email : 'N/A' %>
                                </p>
                            </div>

                            <!-- Order Details -->
                            <div>
                                <p class="text-sm text-gray-600 mb-2">Quantity</p>
                                <p class="text-2xl font-bold text-purple-600"><%= booking.quantity %></p>
                                <p class="text-sm text-gray-600 mt-2">Total Price</p>
                                <p class="text-xl font-bold text-green-600">₹<%= booking.totalPrice %></p>
                            </div>

                            <!-- Delivery Info -->
                            <div>
                                <p class="text-sm text-gray-600 mb-2">Delivery Date</p>
                                <p class="text-sm font-semibold text-gray-900"><%= booking.deliveryDate ? new Date(booking.deliveryDate).toLocaleDateString() : 'TBD' %></p>
                                <p class="text-sm text-gray-600 mt-3 mb-2">Delivery Address</p>
                                <p class="text-xs text-gray-700"><%= booking.deliveryAddress ? booking.deliveryAddress.substring(0, 50) + '...' : 'N/A' %></p>
                            </div>

                            <!-- Status & Actions -->
                            <div>
                                <div class="mb-4">
                                    <p class="text-sm text-gray-600 mb-2">Status</p>
                                    <span class="<%= booking.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : booking.status === 'confirmed' ? 'bg-blue-100 text-blue-800' : booking.status === 'in_progress' ? 'bg-purple-100 text-purple-800' : 'bg-green-100 text-green-800' %> px-3 py-1 rounded-full text-xs font-semibold block text-center">
                                        <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                                    </span>
                                </div>
                                 <% if (booking.status === 'confirmed') { %>
                                    <form action="/employee/bookings/update" method="POST" class="space-y-2">
                                        <input type="hidden" name="id" value="<%= booking._id %>">
                                        <input type="hidden" name="status" value="shipped">
                                        <button type="submit" class="w-full px-3 py-2 bg-purple-500 text-white font-semibold rounded-lg hover:bg-purple-600 transition text-sm">
                                            Mark as Shipped
                                        </button>
                                    </form>
                                <% } else if (booking.status === 'shipped') { %>
                                    <a href="/employee/ship/manage" class="w-full px-3 py-2 bg-indigo-500 text-white font-semibold rounded-lg hover:bg-indigo-600 transition text-sm block text-center">
                                        Manage Tracking
                                    </a>
                                <% } %>
                            </div>
                        </div>

                        <!-- Shipping Details Section -->
                        <% if (booking.shipped) { %>
                            <div class="bg-purple-50 rounded-xl p-5 border border-purple-100">
                                <div class="flex items-center space-x-2 mb-4">
                                    <svg class="w-5 h-5 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path>
                                    </svg>
                                    <h4 class="font-bold text-purple-900 text-sm uppercase tracking-wider">Live Shipping Info</h4>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                                    <div class="bg-white/50 p-3 rounded-lg border border-purple-100">
                                        <p class="text-[10px] text-purple-500 font-bold uppercase mb-1">Transit Status</p>
                                        <p class="text-sm font-bold text-gray-900 capitalize"><%= booking.shipped.status.replace(/_/g, ' ') %></p>
                                    </div>
                                     <div class="bg-white/50 p-3 rounded-lg border border-purple-100">
                                        <p class="text-[10px] text-purple-500 font-bold uppercase mb-1">Current Address</p>
                                        <p class="text-sm font-bold text-gray-900"><%= booking.shipped.currentAddress || 'Origin Sorting Center' %></p>
                                    </div>
                                    <div class="bg-white/50 p-3 rounded-lg border border-purple-100">
                                        <p class="text-[10px] text-purple-500 font-bold uppercase mb-1">Current Hub</p>
                                        <p class="text-sm font-bold text-gray-900"><%= booking.shipped.currentCity || 'Origin Sorting Center' %></p>
                                    </div>
                                    <div class="bg-white/50 p-3 rounded-lg border border-purple-100">
                                        <p class="text-[10px] text-purple-500 font-bold uppercase mb-1">Tracking Log</p>
                                        <p class="text-xs text-gray-700 italic leading-relaxed"><%= booking.shipped.detailes || 'Shipment initiated. Log pending.' %></p>
                                    </div>
                                </div>
                            </div>
                        <% } else { %>
                            <div class="text-center py-4 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                                <p class="text-xs text-gray-500 font-medium italic">No active shipment record found for this booking.</p>
                            </div>
                        <% } %>
                    </div>
                <% }); %>
                            </div>
                        </div>
                    </div>
            
            <% } else { %>
                <div class="bg-white rounded-2xl p-12 shadow-lg text-center">
                    <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2">No assigned bookings</h3>
                    <p class="text-gray-600 mb-6">You don't have any bookings assigned yet. Check back soon!</p>
                    <a href="/employee/dashboard" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-purple-500 to-purple-600 text-white font-bold rounded-lg hover:shadow-lg transition">
                        <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                        Go to Dashboard
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>