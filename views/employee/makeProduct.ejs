<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-green-50 via-slate-50 to-green-50 min-h-screen">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                    </div>
                    <span class="text-2xl font-bold text-green-600">ProShop Employee</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/employee/dashboard" class="px-4 py-2 bg-green-100 text-green-700 rounded-lg font-semibold hover:bg-green-200 transition">Dashboard</a>
                    <a href="/employee/products/manage" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Manage Products</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-12">
        <div class="mb-12">
            <div class="rounded-2xl bg-gradient-to-r from-yellow-100 to-yellow-200 p-8 shadow-lg">
                <h1 class="text-3xl font-bold text-gray-900 mb-2">Add New Product</h1>
                <p class="text-gray-600">List a new item for sale in your assigned categories.</p>
            </div>
        </div>

        <div class="bg-white rounded-3xl shadow-xl border border-green-100 p-8">
            <form action="/employee/products/create" method="POST" class="space-y-8">
                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Basic Information</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Product Name</label>
                            <input type="text" name="name" required class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Category</label>
                            <select name="category" required class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50 font-bold">
                                <option value="">Select Category</option>
                                <% category.forEach(cat => { %>
                                    <option value="<%= cat._id %>"><%= cat.title %></option>
                                <% }) %>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Price (₹)</label>
                            <input type="number" name="price" step="0.01" required class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50 font-bold">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Stock</label>
                            <input type="number" name="stock" value="0" required class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50 font-bold">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">SKU</label>
                            <input type="text" name="sku" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">Short Description</label>
                        <textarea name="shortDescription" rows="2" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50"></textarea>
                    </div>
                </div>

                <div class="space-y-6">
                    <h3 class="text-xl font-bold text-gray-900 border-b-2 border-green-100 pb-2">Media & Logistics</h3>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Thumbnail URL</label>
                            <input type="text" name="thumbnail" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Images (Comma URLs)</label>
                            <input type="text" name="images" placeholder="url1, url2" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Shipping Charge (₹)</label>
                            <input type="number" name="shippingCharge" value="0" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Weight (kg)</label>
                            <input type="number" name="weight" step="0.01" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Brand</label>
                            <input type="text" name="brand" class="w-full px-4 py-3 border-2 border-green-50 rounded-xl focus:border-green-400 outline-none bg-green-50">
                        </div>
                    </div>
                </div>

                <div class="bg-green-50 p-6 rounded-2xl border-2 border-green-100 grid grid-cols-1 md:grid-cols-3 gap-6 items-center">
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" name="isFeatured" id="isFeatured" value="true" class="w-5 h-5 rounded text-green-600">
                        <label for="isFeatured" class="text-sm font-bold text-gray-700">Featured</label>
                    </div>
                    <div class="flex items-center space-x-3">
                        <input type="checkbox" name="isAvailable" id="isAvailable" checked value="true" class="w-5 h-5 rounded text-green-600">
                        <label for="isAvailable" class="text-sm font-bold text-gray-700">Available</label>
                    </div>
                    <div>
                        <select name="status" class="w-full px-4 py-2 border-2 border-white rounded-xl outline-none bg-white font-bold">
                            <option value="active">Active</option>
                            <option value="inactive">Inactive</option>
                        </select>
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-4 pt-6">
                    <button type="submit" class="flex-1 py-4 bg-gradient-to-r from-green-500 to-green-600 text-white font-bold rounded-2xl hover:shadow-lg transition transform hover:scale-[1.02]">
                        Create Product
                    </button>
                    <a href="/employee/dashboard" class="flex-1 py-4 bg-gray-200 text-gray-800 font-bold rounded-2xl hover:bg-gray-300 transition text-center flex items-center justify-center">
                        Discard
                    </a>
                </div>
            </form>
        </div>
    </div>
</body>
</html>