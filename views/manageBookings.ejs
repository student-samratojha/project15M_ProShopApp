<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-yellow-600">ProShop</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <span class="text-gray-700 font-medium">Welcome, <%= user.name %></span>
                    <a href="/secure/customer" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-8">
            <h1 class="text-4xl font-bold text-gray-900">My Bookings</h1>
            <p class="text-gray-600 text-lg">Manage and track your orders</p>
        </div>

        <% if (bookings && bookings.length > 0) { %>
            <div class="space-y-6">
                <% bookings.forEach(function(booking) { %>
                    <div class="bg-white rounded-2xl p-6 shadow-lg">
                        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
                            <!-- Product Info -->
                            <div class="md:col-span-2">
                                <h3 class="text-xl font-bold text-gray-900 mb-2">
                                    <%= booking.product ? booking.product.name : 'Unknown Product' %>
                                </h3>
                                <p class="text-gray-600 mb-2">
                                    <%= booking.product ? booking.product.description : '' %>
                                </p>
                                <div class="flex items-center space-x-4">
                                    <span class="text-sm text-gray-700">
                                        <strong>Quantity:</strong> <%= booking.quantity %>
                                    </span>
                                    <span class="text-sm text-gray-700">
                                        <strong>Price per unit:</strong> ₹<%= booking.product ? booking.product.price : '0' %>
                                    </span>
                                </div>
                            </div>

                            <!-- Booking Details -->
                            <div class="md:col-span-2">
                                <div class="space-y-2">
                                    <div class="flex justify-between">
                                        <span class="text-sm font-semibold text-gray-700">Total Price:</span>
                                        <span class="text-lg font-bold text-yellow-600">₹<%= booking.totalPrice %></span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm font-semibold text-gray-700">Status:</span>
                                        <span class="<%= booking.status === 'cancelled' ? 'text-red-600' : booking.status === 'delivered' ? 'text-green-600' : 'text-blue-600' %> font-semibold">
                                            <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm font-semibold text-gray-700">Delivery Date:</span>
                                        <span class="text-sm text-gray-600">
                                            <%= booking.deliveryDate ? new Date(booking.deliveryDate).toLocaleDateString() : 'TBD' %>
                                        </span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span class="text-sm font-semibold text-gray-700">Payment Method:</span>
                                        <span class="text-sm text-gray-600 capitalize"><%= booking.paymentMethod || 'N/A' %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Delivery Address -->
                        <div class="mt-6 pt-6 border-t border-gray-200">
                            <h4 class="font-bold text-gray-900 mb-2">Delivery Address</h4>
                            <p class="text-sm text-gray-600">
                                <%= booking.deliveryAddress ? booking.deliveryAddress : 'No address provided' %>
                            </p>
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-6 flex flex-wrap gap-4">
                            <% if (booking.status !== 'cancelled' && booking.status !== 'delivered') { %>
                                <form action="/booking/cancel" method="POST" style="display:inline;">
                                    <input type="hidden" name="id" value="<%= booking._id %>">
                                    <button type="submit" class="px-6 py-2 bg-red-500 text-white font-semibold rounded-lg hover:bg-red-600 transition" onclick="return confirm('Are you sure you want to cancel this booking?')">
                                        Cancel Booking
                                    </button>
                                </form>
                            <% } %>
                            <a href="#" class="px-6 py-2 bg-blue-500 text-white font-semibold rounded-lg hover:bg-blue-600 transition">View Details</a>
                        </div>
                    </div>
                <% }); %>
            </div>
        <% } else { %>
            <div class="bg-white rounded-2xl p-12 shadow-lg text-center">
                <svg class="w-16 h-16 text-gray-400 mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                </svg>
                <h3 class="text-2xl font-bold text-gray-900 mb-2">No bookings yet</h3>
                <p class="text-gray-600 mb-6">You haven't created any bookings. Start by browsing products.</p>
                <a href="/secure/customer" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-lg hover:shadow-lg transition">
                    <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                    </svg>
                    Go to Dashboard
                </a>
            </div>
        <% } %>
    </div>
</body>
</html>