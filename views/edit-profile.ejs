<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'Edit Profile' %> - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50">
    <nav class="bg-white shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-yellow-600">ProShop</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/secure/<%= user.role %>" class="text-gray-700 hover:text-yellow-600 font-semibold">Back to Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="min-h-screen flex items-center justify-center px-4 py-12">
        <div class="w-full max-w-4xl">
            <div class="bg-white rounded-3xl shadow-2xl overflow-hidden">
                <div class="bg-gradient-to-r from-yellow-100 to-yellow-200 px-8 py-8">
                    <h1 class="text-3xl font-bold text-yellow-900">Edit Your Profile</h1>
                    <p class="text-gray-600 mt-2">Update your information and keep your account current.</p>
                </div>
                <div class="p-8">
                    <form action="/secure/profile" method="POST" class="grid gap-6 lg:grid-cols-2">
                        <div>
                            <label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Full Name</label>
                            <input type="text" id="name" name="name" value="<%= user.name || '' %>" class="w-full px-4 py-3 border-2 border-yellow-100 rounded-2xl focus:border-yellow-400 focus:outline-none bg-yellow-50" required>
                        </div>

                        <div>
                            <label for="username" class="block text-sm font-semibold text-gray-700 mb-2">Username</label>
                            <input type="text" id="username" name="username" value="<%= user.username || '' %>" class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-400 focus:outline-none bg-blue-50">
                        </div>

                        <div>
                            <label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email Address</label>
                            <input type="email" id="email" name="email" value="<%= user.email || '' %>" readonly class="w-full px-4 py-3 border-2 border-green-100 rounded-2xl bg-green-50 text-gray-500 cursor-not-allowed">
                        </div>

                        <div>
                            <label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Phone Number</label>
                            <input type="tel" id="phone" name="phone" value="<%= user.phone || '' %>" class="w-full px-4 py-3 border-2 border-red-100 rounded-2xl focus:border-red-400 focus:outline-none bg-red-50">
                        </div>

                        <div>
                            <label for="gender" class="block text-sm font-semibold text-gray-700 mb-2">Gender</label>
                            <select id="gender" name="gender" class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-400 focus:outline-none bg-blue-50">
                                <option value="" <%= !user.gender ? 'selected' : '' %>>Select Gender</option>
                                <option value="male" <%= user.gender === 'male' ? 'selected' : '' %>>Male</option>
                                <option value="female" <%= user.gender === 'female' ? 'selected' : '' %>>Female</option>
                                <option value="other" <%= user.gender === 'other' ? 'selected' : '' %>>Other</option>
                            </select>
                        </div>

                        <div>
                            <label for="dateOfBirth" class="block text-sm font-semibold text-gray-700 mb-2">Date of Birth</label>
                            <input type="date" id="dateOfBirth" name="dateOfBirth" value="<%= user.dateOfBirth ? user.dateOfBirth.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 border-2 border-green-100 rounded-2xl focus:border-green-400 focus:outline-none bg-green-50">
                        </div>

                        <div class="lg:col-span-2">
                            <label for="avatar" class="block text-sm font-semibold text-gray-700 mb-2">Avatar URL</label>
                            <input type="url" id="avatar" name="avatar" value="<%= user.avatar || '' %>" placeholder="https://example.com/avatar.jpg" class="w-full px-4 py-3 border-2 border-yellow-100 rounded-2xl focus:border-yellow-400 focus:outline-none bg-yellow-50">
                        </div>

                        <div class="lg:col-span-2 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mt-4">
                            <a href="/secure/<%= user.role %>" class="inline-flex items-center justify-center px-6 py-3 border-2 border-yellow-300 rounded-2xl text-yellow-700 font-semibold hover:bg-yellow-50 transition">Cancel</a>
                            <button type="submit" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-2xl hover:shadow-lg transition">Save Changes</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
