<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Customer Dashboard - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Poppins", sans-serif;
      }
      .nav-text {
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>
  <body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50">
    <!-- Navigation -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center space-x-3">
            <div
              class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                ></path>
              </svg>
            </div>
            <span class="text-2xl font-bold text-yellow-600">ProShop</span>
          </div>
          <div class="flex items-center space-x-4 nav-text">
            <span class="text-gray-700 font-medium"
              >Welcome, <%= user.name %></span
            >
            <a
              href="/"
              class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition"
              >Home</a
            >
            <a
              href="/auth/logout"
              class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition"
              >Logout</a
            >
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-12">
      <!-- Welcome Section -->
      <div class="mb-12">
        <h1 class="text-4xl font-bold text-gray-900 mb-2">My Dashboard</h1>
        <p class="text-gray-600 text-lg">Manage your account and orders</p>
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
        <a
          href="/bookings/manage"
          class="bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl p-8 shadow-lg hover:shadow-xl transition transform hover:scale-105 text-center"
        >
          <div
            class="w-14 h-14 bg-blue-500 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-blue-900 mb-2">My Orders</h3>
          <p class="text-blue-800">View your order history</p>
        </a>

        <a
          href="/secure/manage"
          class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-8 shadow-lg hover:shadow-xl transition transform hover:scale-105 text-center"
        >
          <div
            class="w-14 h-14 bg-green-500 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 5a2 2 0 012-2h6a2 2 0 012 2v12a2 2 0 01-2 2H7a2 2 0 01-2-2V5z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-green-900 mb-2">Addresses</h3>
          <p class="text-green-800">Manage delivery addresses</p>
        </a>

        <a
          href="/secure/edit"
          class="bg-gradient-to-br from-red-100 to-red-200 rounded-2xl p-8 shadow-lg hover:shadow-xl transition transform hover:scale-105 text-center"
        >
          <div
            class="w-14 h-14 bg-red-500 rounded-full flex items-center justify-center mx-auto mb-4"
          >
            <svg
              class="w-7 h-7 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"
              ></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-2xl font-bold text-red-900 mb-2">Settings</h3>
          <p class="text-red-800">Update your preferences</p>
        </a>
      </div>

      <!-- Profile Information Section -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 mb-12">
        <!-- Profile Card -->
        <div
          class="lg:col-span-2 bg-white rounded-2xl shadow-lg overflow-hidden"
        >
          <div class="bg-gradient-to-r from-yellow-100 to-yellow-200 px-8 py-8 flex items-center gap-6">
            <div class="w-24 h-24 rounded-full overflow-hidden border-4 border-white shadow-lg bg-white flex items-center justify-center text-3xl font-bold text-yellow-700">
              <% if (user.avatar) { %>
                <img
                  src="<%= user.avatar %>"
                  alt="<%= user.name %> Avatar"
                  class="w-full h-full object-cover"
                />
              <% } else { %>
                <span><%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %></span>
              <% } %>
            </div>
            <div>
              <h2 class="text-2xl font-bold text-yellow-900">
                Profile Information
              </h2>
              <p class="text-yellow-800 mt-1">Welcome back, <%= user.name %></p>
            </div>
          </div>
          <div class="p-8 space-y-6">
            <!-- Name -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Full Name</label
              >
              <div
                class="bg-yellow-50 border-2 border-yellow-100 rounded-lg p-3"
              >
                <p class="text-gray-900 font-semibold"><%= user.name %></p>
              </div>
            </div>

            <!-- Email -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Email Address</label
              >
              <div class="bg-blue-50 border-2 border-blue-100 rounded-lg p-3">
                <p class="text-gray-900 font-semibold"><%= user.email %></p>
              </div>
            </div>

            <!-- Phone -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Phone Number</label
              >
              <div class="bg-green-50 border-2 border-green-100 rounded-lg p-3">
                <p class="text-gray-900 font-semibold">
                  <%= user.phone || 'Not provided' %>
                </p>
              </div>
            </div>

            <!-- Gender -->
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2"
                >Gender</label
              >
              <div class="bg-red-50 border-2 border-red-100 rounded-lg p-3">
                <p class="text-gray-900 font-semibold">
                  <%= user.gender || 'Not specified' %>
                </p>
              </div>
            </div>

            <!-- Edit Profile Button -->
            <a
              href="/secure/edit"
              class="w-full py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-lg hover:shadow-lg transition transform hover:scale-105 flex items-center justify-center space-x-2 mt-6"
            >
              <svg
                class="w-5 h-5"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                ></path>
              </svg>
              <span>Edit Profile</span>
            </a>
          </div>
        </div>

        <!-- Account Stats -->
        <div class="space-y-6">
          <!-- Account Status -->
          <div
            class="bg-gradient-to-br from-green-100 to-green-200 rounded-2xl p-6 shadow-lg"
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-green-900">Account Status</h3>
              <div
                class="w-10 h-10 bg-green-500 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"
                  ></path>
                </svg>
              </div>
            </div>
            <p class="text-2xl font-bold text-green-900">
              <%= user.isActive ? 'Active' : 'Inactive' %>
            </p>
            <p class="text-green-800 text-sm mt-2">
              Your account is in good standing
            </p>
          </div>

          <!-- Member Since -->
          <div
            class="bg-gradient-to-br from-blue-100 to-blue-200 rounded-2xl p-6 shadow-lg"
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-blue-900">Member Since</h3>
              <div
                class="w-10 h-10 bg-blue-500 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
            </div>
            <p class="text-2xl font-bold text-blue-900">
              <%= user.createdAt ? new Date(user.createdAt).getFullYear() :
              'N/A' %>
            </p>
            <p class="text-blue-800 text-sm mt-2">Premium customer</p>
          </div>

          <!-- Total Orders -->
          <div
            class="bg-gradient-to-br from-red-100 to-red-200 rounded-2xl p-6 shadow-lg"
          >
            <div class="flex items-center justify-between mb-4">
              <h3 class="text-lg font-bold text-red-900">Total Orders</h3>
              <div
                class="w-10 h-10 bg-red-500 rounded-full flex items-center justify-center"
              >
                <svg
                  class="w-6 h-6 text-white"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"
                  ></path>
                </svg>
              </div>
            </div>
           <p class="text-2xl font-bold text-red-900"><%= bookings.length %></p>
<p class="text-red-800 text-sm mt-2">Total active bookings available</p>
          </div>
        </div>
      </div>

      <!-- Danger Zone -->
      <div class="bg-red-100 border-2 border-red-300 rounded-2xl p-8 shadow-lg">
        <div class="flex items-center justify-between">
          <div>
            <h3 class="text-xl font-bold text-red-900 mb-2">Danger Zone</h3>
            <p class="text-red-800">
              Once you delete your account, there is no going back. Please be
              certain.
            </p>
          </div>
          <button
            class="px-6 py-3 bg-red-500 text-white font-bold rounded-lg hover:bg-red-600 transition"
          >
            Delete Account
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
