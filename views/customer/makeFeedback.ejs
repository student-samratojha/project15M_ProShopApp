<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Share Feedback - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: "Poppins", sans-serif;
      }
      .nav-text {
        font-family: "Inter", sans-serif;
      }
    </style>
  </head>
  <body
    class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50 min-h-screen"
  >
    <!-- Navbar -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="flex flex-col sm:flex-row justify-between items-center gap-4 py-3 sm:h-16"
        >
          <!-- Logo -->
          <div class="flex items-center space-x-3">
            <div
              class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center"
            >
              <svg
                class="w-6 h-6 text-white"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 10V3L4 14h7v7l9-11h-7z"
                ></path>
              </svg>
            </div>
            <span class="text-2xl font-bold text-yellow-600">ProShop</span>
          </div>

          <!-- Nav -->
          <div
            class="flex flex-wrap justify-center items-center gap-3 nav-text"
          >
            <span class="text-gray-700 font-medium"
              >Welcome, <%= user.name %></span
            >
            <a
              href="/customer/dashboard"
              class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition"
              >Dashboard</a
            >
            <a
              href="/auth/logout"
              class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition"
              >Logout</a
            >
          </div>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <div class="max-w-3xl mx-auto px-4 py-12">
      <div class="mb-10 text-center">
        <h1 class="text-4xl font-bold text-gray-900">Share Your Experience</h1>
        <p class="text-gray-600 text-lg mt-2">
          Your feedback helps us improve our service for everyone.
        </p>
      </div>

      <div
        class="bg-white rounded-3xl shadow-xl overflow-hidden border border-yellow-100"
      >
        <!-- Form Header -->
        <div
          class="bg-gradient-to-r from-yellow-500 to-yellow-600 p-6 text-white text-center"
        >
          <h2 class="text-2xl font-bold">Feedback Form</h2>
        </div>

        <div class="p-8">
          <form
            action="/customer/feedback/make"
            method="POST"
            class="space-y-6"
          >
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Name Field -->
              <div class="space-y-2">
                <label
                  for="name"
                  class="block text-sm font-bold text-gray-700 uppercase tracking-wider"
                  >Full Name</label
                >
                <input
                  type="text"
                  id="name"
                  name="name"
                  value="<%= user.name %>"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-yellow-500 focus:border-transparent outline-none transition"
                  placeholder="Enter your name"
                />
              </div>

              <!-- Email Field -->
              <div class="space-y-2">
                <label
                  for="email"
                  class="block text-sm font-bold text-gray-700 uppercase tracking-wider"
                  >Email Address</label
                >
                <input
                  type="email"
                  id="email"
                  name="email"
                  value="<%= user.email %>"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-yellow-500 focus:border-transparent outline-none transition"
                  placeholder="Enter your email"
                />
              </div>
            </div>

            <!-- Rating Field -->
            <div class="space-y-2">
              <label
                for="rating"
                class="block text-sm font-bold text-gray-700 uppercase tracking-wider"
                >How would you rate us?</label
              >
              <div class="relative">
                <select
                  id="rating"
                  name="rating"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 appearance-none focus:ring-2 focus:ring-yellow-500 focus:border-transparent outline-none transition bg-white"
                >
                  <option value="" disabled selected>Select a rating</option>
                  <option value="5">⭐⭐⭐⭐⭐ - Excellent</option>
                  <option value="4">⭐⭐⭐⭐ - Very Good</option>
                  <option value="3">⭐⭐⭐ - Good</option>
                  <option value="2">⭐⭐ - Fair</option>
                  <option value="1">⭐ - Poor</option>
                </select>
                <div
                  class="absolute inset-y-0 right-0 flex items-center px-4 pointer-events-none"
                >
                  <svg
                    class="w-5 h-5 text-gray-400"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 9l-7 7-7-7"
                    ></path>
                  </svg>
                </div>
              </div>
            </div>

            <!-- Message Field -->
            <div class="space-y-2">
              <label
                for="message"
                class="block text-sm font-bold text-gray-700 uppercase tracking-wider"
                >Your Message</label
              >
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                class="w-full px-4 py-3 rounded-xl border border-gray-200 focus:ring-2 focus:ring-yellow-500 focus:border-transparent outline-none transition resize-none"
                placeholder="Tell us about your experience..."
              ></textarea>
            </div>

            <!-- Form Footer Actions -->
            <div class="pt-4 flex flex-col sm:flex-row gap-4">
              <button
                type="submit"
                class="flex-1 py-4 bg-yellow-500 hover:bg-yellow-600 text-white font-bold rounded-2xl shadow-lg hover:shadow-xl transition transform hover:-translate-y-1 active:scale-95"
              >
                Submit Feedback
              </button>
              <a
                href="/customer/dashboard"
                class="flex-1 py-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-2xl text-center transition"
              >
                Cancel
              </a>
            </div>
          </form>
        </div>
      </div>

      <!-- Help/Incentive Section -->
      <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
        <div
          class="bg-blue-50 p-6 rounded-3xl border border-blue-100 flex items-start space-x-4"
        >
          <div class="bg-blue-500 p-3 rounded-2xl">
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
              ></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-blue-900">Secure Feedback</h4>
            <p class="text-sm text-blue-700 mt-1">
              Your personal details are safe and visible only to authorized
              staff.
            </p>
          </div>
        </div>

        <div
          class="bg-green-50 p-6 rounded-3xl border border-green-100 flex items-start space-x-4"
        >
          <div class="bg-green-500 p-3 rounded-2xl">
            <svg
              class="w-6 h-6 text-white"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M5 13l4 4L19 7"
              ></path>
            </svg>
          </div>
          <div>
            <h4 class="font-bold text-green-900">Fast Response</h4>
            <p class="text-sm text-green-700 mt-1">
              We review all feedback within 48 business hours.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer spacer -->
    <div class="py-10"></div>
  </body>
</html>
