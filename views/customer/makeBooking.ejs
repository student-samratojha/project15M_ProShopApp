<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Make Booking - ProShop</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .nav-text {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50 overflow-x-hidden">

    <!-- Navbar -->
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 py-3 sm:h-16">

                <!-- Logo -->
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>

                    <span class="text-2xl font-bold text-yellow-600">
                        ProShop
                    </span>
                </div>

                <!-- Nav Buttons -->
                <div class="flex flex-wrap justify-center items-center gap-3 nav-text">
                    <span class="text-gray-700 font-medium text-sm sm:text-base text-center">
                        Welcome, <%= user.name %>
                    </span>

                    <a href="/secure/customer"
                        class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">
                        Dashboard
                    </a>

                    <a href="/auth/logout"
                        class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">
                        Logout
                    </a>
                </div>

            </div>
        </div>
    </nav>

    <!-- Main -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">

        <!-- Heading -->
        <div class="mb-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
                Create Booking
            </h1>

            <p class="text-gray-600 text-base sm:text-lg mt-2">
                Review product and complete your booking
            </p>
        </div>

        <!-- Grid -->
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8">

            <!-- Product Details -->
            <div class="xl:col-span-2">

                <div class="bg-white rounded-2xl p-5 sm:p-6 lg:p-8 shadow-lg">

                    <h2 class="text-2xl font-bold text-gray-900 mb-6">
                        Product Details
                    </h2>

                    <div class="space-y-6">

                        <!-- Product Image -->
                        <div class="bg-gradient-to-br from-yellow-100 to-yellow-200 rounded-2xl p-6 sm:p-8 text-center">

                            <svg class="w-24 h-24 sm:w-32 sm:h-32 text-yellow-600 mx-auto"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24">

                                <path stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M20.354 15.354A9 9 0 015.646 5.646 9 9 0 0120.354 15.354z">
                                </path>

                            </svg>

                            <p class="text-gray-600 mt-4">
                                Product Image
                            </p>
                        </div>

                        <!-- Product Info -->
                        <div>
                            <h3 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2 break-words">
                                <%= product.name %>
                            </h3>

                            <p class="text-gray-600 text-base sm:text-lg mb-4 break-words">
                                <%= product.description || 'No description available' %>
                            </p>
                        </div>

                        <!-- Specifications -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                            <div class="bg-blue-50 rounded-xl p-4">
                                <p class="text-sm text-gray-600">
                                    Category
                                </p>

                                <p class="text-lg font-bold text-gray-900 break-words">
                                    <%= product.category || 'N/A' %>
                                </p>
                            </div>

                            <div class="bg-green-50 rounded-xl p-4">
                                <p class="text-sm text-gray-600">
                                    Stock Status
                                </p>

                                <p class="text-lg font-bold text-green-600">
                                    <%= product.stock > 0 ? 'In Stock' : 'Out of Stock' %>
                                </p>
                            </div>

                            <div class="bg-yellow-50 rounded-xl p-4">
                                <p class="text-sm text-gray-600">
                                    Price per Unit
                                </p>

                                <p class="text-lg font-bold text-yellow-600">
                                    ₹<%= product.price %>
                                </p>
                            </div>

                            <div class="bg-red-50 rounded-xl p-4">
                                <p class="text-sm text-gray-600">
                                    Available Quantity
                                </p>

                                <p class="text-lg font-bold text-red-600">
                                    <%= product.stock %>
                                </p>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <!-- Booking Form -->
            <div>

                <div class="bg-white rounded-2xl p-5 sm:p-6 lg:p-8 shadow-lg xl:sticky xl:top-20">

                    <h2 class="text-xl font-bold text-yellow-900 mb-6">
                        Complete Your Booking
                    </h2>

                    <form action="/bookings/create" method="POST" class="space-y-5">

                        <input type="hidden" name="productId" value="<%= product._id %>">

                        <!-- Quantity -->
                        <div>

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Quantity
                            </label>

                            <div class="flex items-center border-2 border-blue-100 rounded-lg bg-blue-50 overflow-hidden">

                                <button type="button"
                                    class="px-4 py-3 text-blue-600 font-bold text-xl"
                                    onclick="decrementQty()">
                                    −
                                </button>

                                <input type="number"
                                    id="quantity"
                                    name="quantity"
                                    value="1"
                                    min="1"
                                    max="<%= product.stock %>"
                                    class="flex-1 text-center py-3 bg-blue-50 border-0 outline-none font-bold text-lg"
                                    required>

                                <button type="button"
                                    class="px-4 py-3 text-blue-600 font-bold text-xl"
                                    onclick="incrementQty()">
                                    +
                                </button>

                            </div>
                        </div>

                      <!-- Address -->
<div>

    <label class="block text-sm font-semibold text-gray-700 mb-2">
        Delivery Address
    </label>

    <!-- Hidden Input -->
    <input
        type="hidden"
        name="selectedAddressIndex"
        id="selectedAddressIndex"
        value="0"
    >

    <!-- Show Full Address -->
    <textarea
        id="deliveryAddress"
        rows="4"
        readonly
        class="w-full px-4 py-3 border-2 border-green-100 rounded-2xl focus:border-green-400 focus:outline-none bg-green-50 resize-none text-sm sm:text-base"
    ><% if (user && user.addresses && user.addresses.length > 0) { %><%= user.addresses[0] %><% } %></textarea>

    <% if (user && user.addresses && user.addresses.length > 0) { %>

        <div class="mt-3 space-y-2">

            <p class="text-sm font-semibold text-gray-600">
                Saved Addresses
            </p>

            <% user.addresses.forEach((address, index) => { %>

                <button
                    type="button"
                    onclick="selectAddress(`<%= String(address).replace(/`/g, '\\`') %>`, <%= index %>)"
                    class="w-full text-left px-4 py-3 bg-green-100 hover:bg-green-200 rounded-xl transition text-sm text-gray-700 break-words">

                    <span class="font-semibold">
                        Address <%= index + 1 %>:
                    </span>

                    <%= address %>

                </button>

            <% }) %>

        </div>

    <% } %>

</div>

<script>
    function selectAddress(address, index) {

        // textarea me full address show hoga
        document.getElementById("deliveryAddress").value = address;

        // backend me sirf index jayega
        document.getElementById("selectedAddressIndex").value = index;
    }
</script>

                        <!-- Payment -->
                        <div>

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Payment Method
                            </label>

                            <select name="paymentMethod"
                                class="w-full px-4 py-3 border-2 border-red-100 rounded-2xl focus:border-red-400 focus:outline-none bg-red-50"
                                required>

                                <option value="">
                                    Select Payment Method
                                </option>

                                <option value="credit_card">
                                    Credit Card
                                </option>

                                <option value="debit_card">
                                    Debit Card
                                </option>

                                <option value="upi">
                                    UPI
                                </option>

                                <option value="net_banking">
                                    Net Banking
                                </option>

                                <option value="cash_on_delivery">
                                    Cash on Delivery
                                </option>

                            </select>
                        </div>

                        <!-- Delivery Date -->
                        <div>

                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Preferred Delivery Date
                            </label>

                            <input type="date"
                                name="deliveryDate"
                                class="w-full px-4 py-3 border-2 border-yellow-100 rounded-2xl focus:border-yellow-400 focus:outline-none bg-yellow-50"
                                required>

                        </div>

                        <!-- Price Summary -->
                        <div class="bg-yellow-50 border-2 border-yellow-200 rounded-2xl p-4 mt-6">

                            <div class="flex justify-between mb-2">
                                <span class="text-sm text-gray-700">
                                    Unit Price:
                                </span>

                                <span class="font-semibold">
                                    ₹<%= product.price %>
                                </span>
                            </div>

                            <div class="flex justify-between mb-2">
                                <span class="text-sm text-gray-700">
                                    Quantity:
                                </span>

                                <span id="displayQty" class="font-semibold">
                                    1
                                </span>
                            </div>
 <div class="flex justify-between mb-2">
                                <span class="text-sm text-gray-700">
                                    Shipping Charge:
                                </span>

                                <span id="displayQty" class="font-semibold">
                                    <%= product.shippingCharge %>
                                </span>
                            </div>
                            <div class="border-t-2 border-yellow-200 pt-2 flex justify-between">

                                <span class="font-bold text-gray-900">
                                    Total:
                                </span>

                                <span id="totalPrice"
                                    class="text-xl font-bold text-yellow-600">
                                    ₹<%= product.price %>
                                </span>

                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="flex flex-col sm:flex-row gap-3 mt-6">

                            <button type="submit"
                                class="w-full py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-lg hover:shadow-lg transition">
                                Confirm Booking
                            </button>

                            <a href="/secure/customer"
                                class="w-full py-3 bg-gray-200 text-gray-800 font-bold rounded-lg hover:bg-gray-300 transition text-center">
                                Cancel
                            </a>

                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Script -->
    <script>

        const productPrice = <%= product.price %>;
        const maxStock = <%= product.stock %>;
const deliveryPrice = <%=product.shippingCharge%>;

        function updateTotal() {

            const qty = document.getElementById('quantity').value;

            const total = productPrice * qty + deliveryPrice;

            document.getElementById('totalPrice').textContent = '₹' + total;

            document.getElementById('displayQty').textContent = qty;
        }

        function incrementQty() {

            const input = document.getElementById('quantity');

            if (parseInt(input.value) < maxStock) {

                input.value = parseInt(input.value) + 1;

                updateTotal();
            }
        }

        function decrementQty() {

            const input = document.getElementById('quantity');

            if (parseInt(input.value) > 1) {

                input.value = parseInt(input.value) - 1;

                updateTotal();
            }
        }

        document.getElementById('quantity').addEventListener('input', updateTotal);

        updateTotal();

    </script>

</body>
</html>