<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Notifications - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&display=swap" rel="stylesheet">
    <style>body { font-family: 'Poppins', sans-serif; }</style>
</head>
<body class="bg-gradient-to-br from-blue-50 via-slate-50 to-blue-50 min-h-screen">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <span class="text-2xl font-bold text-blue-600">ProShop Notifications</span>
                </div>
                <div class="flex items-center space-x-4">
                    <a href="/customer/dashboard" class="px-4 py-2 bg-blue-100 text-blue-700 rounded-lg font-semibold hover:bg-blue-200 transition">Back to Dashboard</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="flex items-center justify-between mb-10">
            <div>
                <h1 class="text-4xl font-bold text-gray-900">Notification Center</h1>
                <p class="text-gray-600 mt-2">All your account activities and updates.</p>
            </div>
            <% if (unreadNotificationsCount > 0) { %>
                <form action="/customer/notifications/mark-all-read" method="POST">
                    <button type="submit" class="px-6 py-2 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition">
                        Mark All as Read
                    </button>
                </form>
            <% } %>
        </div>

        <% if (notifications && notifications.length > 0) { %>
            <div class="space-y-4">
                <% notifications.forEach(notification => { %>
                    <a href="/customer/notifications/open/<%= notification._id %>" 
                       class="block bg-white rounded-2xl p-6 shadow-md hover:shadow-lg transition border-l-4 <%= notification.isRead ? 'border-gray-200' : 'border-blue-500' %>">
                        <div class="flex items-start justify-between gap-4">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-full flex items-center justify-center 
                                    <%= notification.type === 'booking' ? 'bg-blue-100 text-blue-600' : 
                                        notification.type === 'payment' ? 'bg-green-100 text-green-600' : 'bg-yellow-100 text-yellow-600' %>">
                                    <% if (notification.type === 'booking') { %>
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path></svg>
                                    <% } else if (notification.type === 'payment') { %>
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
                                    <% } else { %>
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                                    <% } %>
                                </div>
                                <div>
                                    <p class="text-gray-900 font-bold <%= notification.isRead ? 'opacity-60' : '' %>"><%= notification.message %></p>
                                    <p class="text-xs text-gray-500 mt-1"><%= new Date(notification.createdAt).toLocaleString() %></p>
                                </div>
                            </div>
                            <% if (!notification.isRead) { %>
                                <span class="bg-blue-100 text-blue-700 text-[10px] font-extrabold uppercase px-2 py-1 rounded">New</span>
                            <% } %>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } else { %>
            <div class="bg-white rounded-3xl p-16 shadow-xl text-center">
                <svg class="w-20 h-20 text-gray-200 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"></path>
                </svg>
                <h3 class="text-2xl font-bold text-gray-900">Inbox is empty</h3>
                <p class="text-gray-500 mt-2">You don't have any notifications at the moment.</p>
                <a href="/customer/dashboard" class="inline-block mt-8 text-blue-600 font-bold hover:underline">Return to Dashboard</a>
            </div>
        <% } %>
    </div>

    <footer class="py-12 text-center text-gray-400 text-sm">
        <p>&copy; 2026 ProShop Management System.</p>
    </footer>
</body>
</html>