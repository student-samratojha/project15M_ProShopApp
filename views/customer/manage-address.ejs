<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Addresses - ProShop</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Poppins', sans-serif; }
        .nav-text { font-family: 'Inter', sans-serif; }
    </style>
</head>
<body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50">
    <nav class="bg-white shadow-md sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between h-16 items-center">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">
                        <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                        </svg>
                    </div>
                    <span class="text-2xl font-bold text-yellow-600">ProShop</span>
                </div>
                <div class="flex items-center space-x-4 nav-text">
                    <a href="/secure/<%= user.role %>" class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">Dashboard</a>
                    <a href="/auth/logout" class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">Logout</a>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 py-12">
        <div class="mb-8">
            <h1 class="text-3xl font-bold text-gray-900">Manage Addresses</h1>
            <p class="text-gray-600">Add, view, and manage your delivery addresses (max 5).</p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
            <!-- Address List -->
            <div class="lg:col-span-2 space-y-6">
                <% if (user.addresses && user.addresses.length > 0) { %>
                    <% user.addresses.forEach(function(addr, idx) { %>
                        <div class="bg-white rounded-2xl p-6 shadow-lg">
                            <div class="flex items-start justify-between gap-4">
                                <div>
                                    <h3 class="text-lg font-bold text-gray-900"><%= addr.fullName || 'Unnamed' %></h3>
                                    <p class="text-sm text-gray-600"><%= addr.addressLine || '' %></p>
                                    <p class="text-sm text-gray-600"><%= addr.city ? (addr.city + ', ') : '' %><%= addr.state ? (addr.state + ', ') : '' %><%= addr.country || '' %> - <%= addr.pincode || '' %></p>
                                    <p class="text-sm text-gray-600 mt-2">Phone: <%= addr.phone || 'N/A' %></p>
                                </div>
                                <div class="text-right space-y-3">
                                    <% if (addr.isDefault) { %>
                                        <span class="inline-block px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-semibold">Default</span>
                                    <% } %>
                                    <form action="/secure/address/delete" method="POST" class="inline-block">
                                        <input type="hidden" name="addressId" value="<%= addr._id %>">
                                        <button type="submit" class="inline-flex items-center justify-center px-3 py-2 bg-red-500 text-white rounded-2xl text-sm font-semibold hover:bg-red-600 transition">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="bg-white rounded-2xl p-8 shadow-lg text-center">
                        <h3 class="text-xl font-bold text-gray-900">No addresses yet</h3>
                        <p class="text-gray-600 mt-2">Add a delivery address using the form on the right.</p>
                    </div>
                <% } %>
            </div>

            <!-- Add Address Form -->
            <div>
                <div class="bg-white rounded-2xl p-6 shadow-lg">
                    <h3 class="text-xl font-bold text-yellow-900 mb-4">Add New Address</h3>
                    <form action="/secure/address" method="POST" class="space-y-4">
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Full Name</label>
                            <input type="text" name="address[fullName]" class="w-full px-4 py-3 border-2 border-yellow-100 rounded-2xl focus:border-yellow-400 bg-yellow-50" required>
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Phone</label>
                            <input type="tel" name="address[phone]" class="w-full px-4 py-3 border-2 border-red-100 rounded-2xl focus:border-red-400 bg-red-50">
                        </div>

                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">Address Line</label>
                            <input type="text" name="address[addressLine]" class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-400 bg-blue-50" required>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">City</label>
                                <input type="text" name="address[city]" class="w-full px-4 py-3 border-2 border-green-100 rounded-2xl focus:border-green-400 bg-green-50">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">State</label>
                                <input type="text" name="address[state]" class="w-full px-4 py-3 border-2 border-blue-100 rounded-2xl focus:border-blue-400 bg-blue-50">
                            </div>
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Country</label>
                                <input type="text" name="address[country]" class="w-full px-4 py-3 border-2 border-yellow-100 rounded-2xl focus:border-yellow-400 bg-yellow-50">
                            </div>
                            <div>
                                <label class="block text-sm font-semibold text-gray-700 mb-2">Pincode</label>
                                <input type="text" name="address[pincode]" class="w-full px-4 py-3 border-2 border-red-100 rounded-2xl focus:border-red-400 bg-red-50">
                            </div>
                        </div>

                        <div>
                            <label class="inline-flex items-center">
                                <input type="checkbox" name="address[isDefault]" value="true" class="form-checkbox h-4 w-4 text-yellow-600">
                                <span class="ml-2 text-sm text-gray-700">Set as default</span>
                            </label>
                        </div>

                        <div class="flex items-center justify-between gap-4">
                            <a href="/secure/<%= user.role %>" class="inline-flex items-center justify-center px-4 py-2 border-2 border-yellow-300 rounded-2xl text-yellow-700 font-semibold hover:bg-yellow-50 transition">Back</a>
                            <button type="submit" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-2xl hover:shadow-lg transition">Add Address</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>