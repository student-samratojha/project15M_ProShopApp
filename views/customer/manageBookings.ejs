<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Bookings - ProShop</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Poppins', sans-serif;
        }

        .nav-text {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>

<body class="bg-gradient-to-br from-yellow-50 via-slate-50 to-yellow-50 min-h-screen">

    <!-- Navbar -->
    <nav class="bg-white shadow-md sticky top-0 z-50">

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

            <div class="flex flex-col sm:flex-row justify-between items-center gap-4 py-3 sm:h-16">

                <!-- Logo -->
                <div class="flex items-center space-x-3">

                    <div class="w-10 h-10 bg-gradient-to-br from-yellow-500 to-yellow-600 rounded-lg flex items-center justify-center">

                        <svg class="w-6 h-6 text-white"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24">

                            <path stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M13 10V3L4 14h7v7l9-11h-7z">
                            </path>

                        </svg>

                    </div>

                    <span class="text-2xl font-bold text-yellow-600">
                        ProShop
                    </span>

                </div>

                <!-- Nav -->
                <div class="flex flex-wrap justify-center items-center gap-3 nav-text">

                    <span class="text-gray-700 font-medium">
                        Welcome, <%= user.name %>
                    </span>

                    <a href="/customer/dashboard"
                        class="px-4 py-2 bg-yellow-100 text-yellow-700 rounded-lg font-semibold hover:bg-yellow-200 transition">
                        Dashboard
                    </a>

                    <a href="/customer/feedback/make"
                        class="px-4 py-2 bg-purple-100 text-purple-700 rounded-lg font-semibold hover:bg-purple-200 transition">
                        Feedback
                    </a>

                    <a href="/auth/logout"
                        class="px-4 py-2 bg-red-100 text-red-700 rounded-lg font-semibold hover:bg-red-200 transition">
                        Logout
                    </a>

                </div>

            </div>

        </div>

    </nav>

    <!-- Main -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">

        <!-- Heading -->
        <div class="mb-10">

            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900">
                My Bookings
            </h1>

            <p class="text-gray-600 text-lg mt-2">
                Manage and track your orders
            </p>

        </div>

        <% if (bookings && bookings.length > 0) { %>

            <!-- Booking Cards -->
            <div class="grid grid-cols-1 lg:grid-cols-1 gap-8">

                <% bookings.forEach(function(booking) { %>

                    <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-yellow-100">
                        
                        <!-- Top -->
                        <div class="bg-gradient-to-r from-yellow-500 to-yellow-600 p-6 text-white">

                            <div class="flex justify-between items-start gap-4 flex-wrap">

                                <div>

                                    <h2 class="text-2xl font-bold break-words">
                                        <%= booking.product ? booking.product.name : 'Unknown Product' %>
                                    </h2>

                                    <p class="text-yellow-100 text-sm mt-1">
                                        Booking ID :
                                        <%= booking._id %>
                                    </p>

                                </div>

                                <div>

                                    <span class="px-4 py-1 rounded-full text-sm font-bold bg-white
                                        <%= booking.status === 'cancelled'
                                            ? 'text-red-600'
                                            : booking.status === 'delivered'
                                            ? 'text-green-600'
                                            : 'text-blue-600' %>">

                                        <%= booking.status.charAt(0).toUpperCase() + booking.status.slice(1) %>

                                    </span>
                                </div>

                            </div>

                        </div>

                        <!-- Content -->
                        <div class="p-6 space-y-6">

                            <!-- Product Description -->
                            <div>

                                <h3 class="font-bold text-gray-900 mb-2 text-lg">
                                    Product Description
                                </h3>

                                <p class="text-gray-600 leading-relaxed break-words">
                                    <%= booking.product ? booking.product.description : 'No description available' %>
                                </p>

                            </div>

                            <!-- Product Details -->
                            <div>

                                <h3 class="font-bold text-gray-900 mb-4 text-lg">
                                    Product Details
                                </h3>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div class="bg-blue-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600">
                                            Quantity
                                        </p>

                                        <p class="text-xl font-bold text-blue-700">
                                            <%= booking.quantity %>
                                        </p>

                                    </div>

                                    <div class="bg-yellow-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600">
                                            Price Per Unit
                                        </p>

                                        <p class="text-xl font-bold text-yellow-700">
                                            ₹<%= booking.product ? booking.product.price : '0' %>
                                        </p>

                                    </div>

                                    <div class="bg-green-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600">
                                            Total Price
                                        </p>

                                        <p class="text-2xl font-bold text-green-700">
                                            ₹<%= booking.totalPrice %>
                                        </p>

                                    </div>

                                    <div class="bg-red-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600">
                                            Payment Method
                                        </p>

                                        <p class="text-lg font-bold text-red-700 flex items-center justify-between capitalize">
                                            <%= booking.paymentMethod || 'N/A' %> 
                                            <%if(booking.paymentStatus !== "paid"){%>   
<a href="/customer/bookings/payment/<%=booking._id%>"class='text-lg font-bold text-red-700 hover:underline transition duration-300'>Pay Now</a>
<%} else {%>
    <span class='text-lg font-bold text-green-600'>
        Paid
    </span>
                           <%}%>             </p>

                                    </div>

                                </div>

                            </div>

                            <!-- Delivery Details -->
                            <div>

                                <h3 class="font-bold text-gray-900 mb-4 text-lg">
                                    Delivery Details
                                </h3>

                                <div class="space-y-4">

                                    <div class="bg-slate-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600 mb-1">
                                            Delivery Date
                                        </p>

                                        <p class="font-bold text-gray-900">
                                            <%= booking.deliveryDate
                                                ? new Date(booking.deliveryDate).toLocaleDateString()
                                                : 'TBD' %>
                                        </p>

                                    </div>

                                    <div class="bg-slate-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600 mb-1">
                                            Delivery Address
                                        </p>

                                        <p class="font-semibold text-gray-800 break-words leading-relaxed">
                                            <%= booking.deliveryAddress || 'No address provided' %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                            <!-- Dates -->
                            <div>

                                <h3 class="font-bold text-gray-900 mb-4 text-lg">
                                    Booking Timeline
                                </h3>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

                                    <div class="bg-purple-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600">
                                            Booking Created
                                        </p>

                                        <p class="font-bold text-purple-700">
                                            <%= booking.createdAt
                                                ? new Date(booking.createdAt).toLocaleString()
                                                : 'N/A' %>
                                        </p>

                                    </div>

                                    <div class="bg-indigo-50 rounded-2xl p-4">

                                        <p class="text-sm text-gray-600">
                                            Last Updated
                                        </p>

                                        <p class="font-bold text-indigo-700">
                                            <%= booking.updatedAt
                                                ? new Date(booking.updatedAt).toLocaleString()
                                                : 'N/A' %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                            <!-- Shipping Details Section -->
                            <% if (booking.shipped) { %>
                                <div class="bg-yellow-50 rounded-xl p-5 border border-yellow-100">
                                    <div class="flex items-center space-x-2 mb-4">
                                        <svg class="w-5 h-5 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"></path>
                                        </svg>
                                        <h4 class="font-bold text-yellow-900 text-sm uppercase tracking-wider">Live Shipping Info</h4>
                                    </div>
                                    <div class="grid grid-cols-1 md:grid-cols-5 gap-4">
                                        <% if (booking.shipped.trackingLogs && booking.shipped.trackingLogs.length > 0) { %>
                                            <div class="md:col-span-5 space-y-3">
                                                <% booking.shipped.trackingLogs.forEach(function(log, logIndex) { %>
                                                    <div class="bg-white/50 p-3 rounded-lg border border-yellow-100">
                                                        <p class="text-[10px] text-yellow-500 font-bold uppercase mb-1">Log #<%= logIndex + 1 %></p>
                                                        <p class="text-sm font-bold text-gray-900 capitalize">Status: <%= log.status.replace(/_/g, ' ') %></p>
                                                        <p class="text-xs text-gray-700">City: <%= log.city || 'N/A' %></p>
                                                        <p class="text-xs text-gray-700">Address: <%= log.address || 'N/A' %></p>
                                                        <p class="text-xs text-gray-700 italic leading-relaxed">Message: <%= log.message || 'No message' %></p>
                                                        <% if (log.time) { %>
                                                            <p class="text-xs text-gray-500 mt-1">Time: <%= new Date(log.time).toLocaleString() %></p>
                                                        <% } %>
                                                    </div>
                                                <% }); %>
                                            </div>
                                        <% } else { %>
                                            <div class="bg-white/50 p-3 rounded-lg border border-yellow-100 md:col-span-5">
                                                <p class="text-[10px] text-yellow-500 font-bold uppercase mb-1">Transit Status</p>
                                                <p class="text-sm font-bold text-gray-900 capitalize"><%= booking.shipped.status.replace(/_/g, ' ') %></p>
                                            </div>
                                            <div class="bg-white/50 p-3 rounded-lg border border-yellow-100 md:col-span-5">
                                                <p class="text-[10px] text-yellow-500 font-bold uppercase mb-1">Date</p>
                                                <p class="text-sm font-bold text-gray-900"><%= booking.shipped.updatedAt.toLocaleString() || 'N/A' %></p>
                                            </div>
                                            <div class="bg-white/50 p-3 rounded-lg border border-yellow-100 md:col-span-5">
                                                <p class="text-[10px] text-yellow-500 font-bold uppercase mb-1">Current Address</p>
                                                <p class="text-sm font-bold text-gray-900"><%= booking.shipped.currentAddress || 'Origin Sorting Center' %></p>
                                            </div>
                                            <div class="bg-white/50 p-3 rounded-lg border border-yellow-100 md:col-span-5">
                                                <p class="text-[10px] text-yellow-500 font-bold uppercase mb-1">Current Hub</p>
                                                <p class="text-sm font-bold text-gray-900"><%= booking.shipped.currentCity || 'Origin Sorting Center' %></p>
                                            </div>
                                            <div class="bg-white/50 p-3 rounded-lg border border-yellow-100 md:col-span-5">
                                                <p class="text-[10px] text-yellow-500 font-bold uppercase mb-1">Details</p>
                                                <p class="text-xs text-gray-700 italic leading-relaxed"><%= booking.shipped.detailes || 'Shipment initiated. Log pending.' %></p>
                            
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            <% } else { %>
                                <div class="text-center py-4 bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                                    <p class="text-xs text-gray-500 font-medium italic">No active shipment record found for this booking.</p>
                                </div>
                            <% } %>

                            <!-- Action Buttons -->
                            <div class="pt-4">
                                <% if (booking.status !== 'cancelled' && booking.status !== 'delivered' && booking.status !== 'shipped') { %>
                                    <form action="/customer/bookings/cancel/<%= booking._id %>" method="POST">
                                        <button type="submit"
                                            onclick="return confirm('Are you sure you want to cancel this booking?')"
                                            class="w-full py-4 bg-red-500 hover:bg-red-600 text-white font-bold rounded-2xl transition duration-300">
                                            Cancel Booking
                                        </button>
                                    </form>
                                <% } else if (booking.status === 'shipped') { %>
                                    <p class="text-center text-sm text-gray-600 font-semibold">
                                        Your order has been shipped. Please contact support for further assistance.
                                    </p>
                                <% } else if (booking.status === 'delivered') { %>
                                    <p class="text-center text-sm text-gray-600 font-semibold">
                                        Your order has been delivered.
                                    </p>
                                <% } else if (booking.status === 'cancelled') { %>
                                    <p class="text-center text-sm text-gray-600 font-semibold">
                                        This booking has been cancelled.
                                    </p>
                                <% } %>
                            </div>

                        </div>

                    </div>

                <% }); %>

            </div>

        <% } else { %>

            <!-- Empty State -->
            <div class="bg-white rounded-3xl p-12 shadow-xl text-center">

                <svg class="w-20 h-20 text-gray-400 mx-auto mb-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24">

                    <path stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                    </path>

                </svg>

                <h3 class="text-3xl font-bold text-gray-900 mb-3">
                    No bookings yet
                </h3>

                <p class="text-gray-600 mb-8 text-lg">
                    You haven't created any bookings. Start by browsing products.
                </p>

                <a href="/customer/dashboard"
                    class="inline-flex items-center justify-center px-8 py-4 bg-gradient-to-r from-yellow-500 to-yellow-600 text-white font-bold rounded-2xl hover:shadow-xl transition">

                    <svg class="w-5 h-5 mr-2"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24">

                        <path stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 19l-7-7m0 0l7-7m-7 7h18">
                        </path>

                    </svg>

                    Go to Dashboard

                </a>

            </div>

        <% } %>

    </div>

</body>
</html>